                        CommandParameter="Resident"
                        Content="အဆောင်နေသူများ"
                        GroupName="SidebarNav"
                        Style="{StaticResource SidebarItemStyle}"
                        Tag="M320,312 C386.3,312 440,258.3 440,192 C440,125.7 386.3,72 320,72 C253.7,72 200,125.7 200,192 C200,258.3 253.7,312 320,312 Z M290.3,368 C191.8,368 112,447.8 112,546.3 C112,562.7 125.3,576 141.7,576 L498.3,576 C514.7,576 528,562.7 528,546.3 C528,447.8 448.2,368 349.7,368 L290.3,368 Z" />

                    <RadioButton
                        Command="{Binding NavigateToCommand}"
                        CommandParameter="Building"
                        Content="အဆောင်စီမံခန့်ခွဲမှု"
                        GroupName="SidebarNav"
                        Style="{StaticResource SidebarItemStyle}"
                        Tag="M4,22 V2 H20 V22 H14 V16 H10 V22 Z M8,6 H10 V8 H8 Z M14,6 H16 V8 H14 Z M8,11 H10 V13 H8 Z M14,11 H16 V13 H14 Z" />

                    <RadioButton
                        Command="{Binding NavigateToCommand}"
                        CommandParameter="FeeRule"
                        Content="အခန်းခနှုန်းထားများ"
                        GroupName="SidebarNav"
                        Style="{StaticResource SidebarItemStyle}"
                        Tag="M128 128C128 92.7 156.7 64 192 64L341.5 64C358.5 64 374.8 70.7 386.8 82.7L493.3 189.3C505.3 201.3 512 217.6 512 234.6L512 512C512 547.3 483.3 576 448 576L192 576C156.7 576 128 547.3 128 512L128 128zM336 122.5L336 216C336 229.3 346.7 240 360 240L453.5 240L336 122.5zM192 152C192 165.3 202.7 176 216 176L264 176C277.3 176 288 165.3 288 152C288 138.7 277.3 128 264 128L216 128C202.7 128 192 138.7 192 152zM192 248C192 261.3 202.7 272 216 272L264 272C277.3 272 288 261.3 288 248C288 234.7 277.3 224 264 224L216 224C202.7 224 192 234.7 192 248zM304 324L304 328C275.2 328.3 252 351.7 252 380.5C252 406.2 270.5 428.1 295.9 432.3L337.6 439.3C343.6 440.3 348 445.5 348 451.6C348 458.5 342.4 464.1 335.5 464.1L280 464C269 464 260 473 260 484C260 495 269 504 280 504L304 504L304 508C304 519 313 528 324 528C335 528 344 519 344 508L344 503.3C369 499.2 388 477.6 388 451.5C388 425.8 369.5 403.9 344.1 399.7L302.4 392.7C296.4 391.7 292 386.5 292 380.4C292 373.5 297.6 367.9 304.5 367.9L352 367.9C363 367.9 372 358.9 372 347.9C372 336.9 363 327.9 352 327.9L344 327.9L344 323.9C344 312.9 335 303.9 324 303.9C313 303.9 304 312.9 304 323.9z" />
                    <RadioButton
                        Command="{Binding NavigateToCommand}"
                        CommandParameter="Payment"
                        Content="ငွေပေးချေမှု"
                        GroupName="SidebarNav"
                        Style="{StaticResource SidebarItemStyle}"
