<Window
    x:Class="HostelManagementSystem.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:HostelManagementSystem.ViewModels"
    Title="Hostel Management System"
    Width="800"
    Height="450"
    Background="Transparent"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    mc:Ignorable="d">

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Column 0: Sidebar Panel (Uncovered)  -->
        <Border
            Grid.Column="0"
            Panel.ZIndex="1"
            Background="{DynamicResource CardBackground}">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="15"
                    Direction="0"
                    Opacity="0.1"
                    ShadowDepth="4"
                    Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,10,0,0">
                    <!--  App Title Logo Header  -->
                    <StackPanel
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Image
                            Width="50"
                            Height="50"
                            Source="pack://application:,,,/Image/tht_logo.png" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="HMS" />
                    </StackPanel>

                    <!--  Navigation Items  -->
                    <RadioButton
                        Command="{Binding NavigateToCommand}"
                        CommandParameter="Dashboard"
                        Content="Dashboard"
                        GroupName="SidebarNav"
                        IsChecked="True"
                        Style="{StaticResource SidebarItemStyle}"
                        Tag="M3,4 A1,1 0 0,1 4,3 H9 A1,1 0 0,1 10,4 V11 A1,1 0 0,1 9,12 H4 A1,1 0 0,1 3,11 Z M14,4 A1,1 0 0,1 15,3 H20 A1,1 0 0,1 21,4 V7 A1,1 0 0,1 20,8 H15 A1,1 0 0,1 14,7 Z M14,13 A1,1 0 0,1 15,12 H20 A1,1 0 0,1 21,13 V20 A1,1 0 0,1 20,21 H15 A1,1 0 0,1 14,20 Z M3,17 A1,1 0 0,1 4,16 H9 A1,1 0 0,1 10,17 V20 A1,1 0 0,1 9,21 H4 A1,1 0 0,1 3,20 Z" />

                    <RadioButton
                        Command="{Binding NavigateToCommand}"
                        CommandParameter="Resident"
                        Content="အဆောင်နေသူများ"
                        GroupName="SidebarNav"
                        Style="{StaticResource SidebarItemStyle}"
                        Tag="M320,312 C386.3,312 440,258.3 440,192 C440,125.7 386.3,72 320,72 C253.7,72 200,125.7 200,192 C200,258.3 253.7,312 320,312 Z M290.3,368 C191.8,368 112,447.8 112,546.3 C112,562.7 125.3,576 141.7,576 L498.3,576 C514.7,576 528,562.7 528,546.3 C528,447.8 448.2,368 349.7,368 L290.3,368 Z" />

                    <RadioButton
                        Command="{Binding NavigateToCommand}"
                        CommandParameter="Building"
                        Content="အဆောင်စီမံခန့်ခွဲမှု"
                        GroupName="SidebarNav"
                        Style="{StaticResource SidebarItemStyle}"
                        Tag="M4,22 V2 H20 V22 H14 V16 H10 V22 Z M8,6 H10 V8 H8 Z M14,6 H16 V8 H14 Z M8,11 H10 V13 H8 Z M14,11 H16 V13 H14 Z" />

                    <RadioButton
                        Command="{Binding NavigateToCommand}"
                        CommandParameter="DataTransfer"
                        Content="ဒေတာလွှဲပြောင်းခြင်း"
                        GroupName="SidebarNav"
                        Style="{StaticResource SidebarItemStyle}"
                        Tag="M12,3C7.58,3 4,4.79 4,7V17C4,19.21 7.58,21 12,21C16.42,21 20,19.21 20,17V7C20,4.79 16.42,3 12,3ZM18,17C18,17.5 15.87,19 12,19C8.13,19 6,17.5 6,17V14.77C7.61,15.55 9.72,16 12,16C14.28,16 16.39,15.55 18,14.77V17ZM18,12.5C16.39,13.28 14.28,13.73 12,13.73C9.72,13.73 7.61,13.28 6,12.5V9.77C7.61,10.55 9.72,11 12,11C14.28,11 16.39,10.55 18,9.77V12.5ZM12,5C15.87,5 18,6.5 18,7C18,7.5 15.87,9 12,9C8.13,9 6,7.5 6,7C6,6.5 8.13,5 12,5Z" />
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                    <RadioButton
                        Margin="10,0,10,10"
                        Command="{Binding NavigateToCommand}"
                        CommandParameter="Setting"
                        Content="Setting"
                        GroupName="SidebarNav"
                        Style="{StaticResource SidebarItemStyle}"
                        Tag="M9.671,4.136 A2.34,2.34 0 0,1 14.33,4.136 A2.34,2.34 0 0,0 17.649,6.051 A2.34,2.34 0 0,1 19.979,10.084 A2.34,2.34 0 0,0 19.979,13.915 A2.34,2.34 0 0,1 17.649,17.948 A2.34,2.34 0 0,0 14.33,19.863 A2.34,2.34 0 0,1 9.671,19.863 A2.34,2.34 0 0,0 6.351,17.948 A2.34,2.34 0 0,1 4.021,13.915 A2.34,2.34 0 0,0 4.021,10.084 A2.34,2.34 0 0,1 6.351,6.051 A2.34,2.34 0 0,0 9.671,4.136 Z M12,9 A3,3 0 1,1 12,15 A3,3 0 1,1 12,9 Z" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Column 1: Container wrapping Main Content & Loading Overlay  -->
        <Grid Grid.Column="1">
            <!--  Main Content View Frame  -->
            <Border Background="{DynamicResource WindowBackground}">
                <ContentControl Margin="20" Content="{Binding CurrentView}" />
            </Border>

            <!--  Loading Spinner Overlay (Applies ONLY to Column 1)  -->
            <Grid
                Panel.ZIndex="999"
                Background="#80000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">

                <Border
                    Padding="30,25"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CardBackground}"
                    CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="20"
                            Direction="0"
                            Opacity="0.2"
                            ShadowDepth="4"
                            Color="#000000" />
                    </Border.Effect>

                    <StackPanel HorizontalAlignment="Center">
                        <!--  Spinner Icon  -->
                        <Viewbox
                            Width="50"
                            Height="50"
                            Margin="0,0,0,15">
                            <Grid Width="48" Height="48">
                                <Ellipse Stroke="#E0E0E0" StrokeThickness="4" />
                                <Path
                                    RenderTransformOrigin="0.5,0.5"
                                    Stroke="#007ACC"
                                    StrokeEndLineCap="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="4">
                                    <Path.Data>
                                        <PathGeometry>
                                            <PathFigure StartPoint="24,2">
                                                <ArcSegment
                                                    Point="46,24"
                                                    Size="22,22"
                                                    SweepDirection="Clockwise" />
                                            </PathFigure>
                                        </PathGeometry>
                                    </Path.Data>
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="SpinnerRotation" Angle="0" />
                                    </Path.RenderTransform>
                                    <Path.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        RepeatBehavior="Forever"
                                                        Storyboard.TargetName="SpinnerRotation"
                                                        Storyboard.TargetProperty="Angle"
                                                        From="0"
                                                        To="360"
                                                        Duration="0:0:0.9" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Path.Triggers>
                                </Path>
                            </Grid>
                        </Viewbox>

                        <!--  Busy Text Readout  -->
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="{Binding BusyText}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>