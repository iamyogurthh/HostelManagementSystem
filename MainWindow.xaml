<Window
    x:Class="HostelManagementSystem.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:HostelManagementSystem.ViewModels"
    Title="Hostel Management System"
    Width="800"
    Height="450"
    Background="Transparent"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    mc:Ignorable="d">

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ThemeToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="34" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource WindowBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <Border
                                    x:Name="lightSegment"
                                    Margin="1"
                                    Padding="8,0"
                                    Background="Transparent"
                                    CornerRadius="5">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="White"
                                        Text="☼  Light" />
                                </Border>

                                <Border
                                    x:Name="darkSegment"
                                    Grid.Column="1"
                                    Margin="1"
                                    Padding="8,0"
                                    Background="Transparent"
                                    CornerRadius="5">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextPrimary}"
                                        Text="◐  Dark" />
                                </Border>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="lightSegment" Property="Background" Value="{DynamicResource PrimaryAccent}" />
                                <Setter TargetName="lightSegment" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect
                                            BlurRadius="3"
                                            Opacity="0.12"
                                            ShadowDepth="1" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="darkSegment" Property="Background" Value="{DynamicResource PrimaryAccent}" />
                                <Setter TargetName="darkSegment" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect
                                            BlurRadius="3"
                                            Opacity="0.12"
                                            ShadowDepth="1" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Column 0: Sidebar Panel (Uncovered)  -->
        <Border
            Grid.Column="0"
            Panel.ZIndex="1"
            Background="{DynamicResource CardBackground}">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="15"
                    Direction="0"
                    Opacity="0.1"
                    ShadowDepth="4"
                    Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,10,0,0">
                    <!--  App Title Logo Header  -->
                    <StackPanel
                        Margin="10,0,0,10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Image
                            Width="32"
                            Height="32"
                            Margin="0,0,8,0"
                            Source="pack://application:,,,/Image/hms_logo.png" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#E4DE26"
                            Text="Shwe Hostel" />
                    </StackPanel>

                    <!--  Navigation Items  -->
                    <RadioButton
                        Command="{Binding NavigateToCommand}"
                        CommandParameter="Dashboard"
                        Content="Dashboard"
                        GroupName="SidebarNav"
                        IsChecked="True"
                        Style="{StaticResource SidebarItemStyle}"
                        Tag="M3,4 A1,1 0 0,1 4,3 H9 A1,1 0 0,1 10,4 V11 A1,1 0 0,1 9,12 H4 A1,1 0 0,1 3,11 Z M14,4 A1,1 0 0,1 15,3 H20 A1,1 0 0,1 21,4 V7 A1,1 0 0,1 20,8 H15 A1,1 0 0,1 14,7 Z M14,13 A1,1 0 0,1 15,12 H20 A1,1 0 0,1 21,13 V20 A1,1 0 0,1 20,21 H15 A1,1 0 0,1 14,20 Z M3,17 A1,1 0 0,1 4,16 H9 A1,1 0 0,1 10,17 V20 A1,1 0 0,1 9,21 H4 A1,1 0 0,1 3,20 Z" />

                    <RadioButton
