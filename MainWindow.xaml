<Window x:Class="HostelManagementSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HostelManagementSystem"
        xmlns:viewmodels="clr-namespace:HostelManagementSystem.ViewModels"
        xmlns:views="clr-namespace:HostelManagementSystem.Views"
        xmlns:roomVm="clr-namespace:HostelManagementSystem.ViewModels.RoomViewModels"
        xmlns:roomdetailVm ="clr-namespace:HostelManagementSystem.ViewModels.RoomDetailViewModels"
        xmlns:roomViews="clr-namespace:HostelManagementSystem.Views.RoomViews"
        xmlns:roomDetailViews="clr-namespace:HostelManagementSystem.Views.RoomDetailViews"
        mc:Ignorable="d"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Title="Hostel Management System" Height="450" Width="800">

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Sidebar related pages-->
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:BuildingViewModel}">
            <views:BuildingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ResidentViewModel}">
            <views:ResidentView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SettingViewModel}">
            <views:SettingView />
        </DataTemplate>

        <!-- Building related pages-->
        <DataTemplate DataType="{x:Type viewmodels:CreateBuildingFormViewModel}">
            <views:CreateBuildingFormView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:EditBuildingFormViewModel}">
            <views:EditBuildingFormView />
        </DataTemplate>

        <!-- Floor related pages-->
        <DataTemplate DataType="{x:Type viewmodels:FloorViewModel}">
            <views:FloorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CreateFloorFormViewModel}">
            <views:CreateFloorFormView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:EditFloorFormViewModel}">
            <views:EditFloorFormView />
        </DataTemplate>

        <!-- Room related pages-->
        <DataTemplate DataType="{x:Type viewmodels:RoomViewModel}">
            <views:RoomView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type roomVm:CreateRoomFormViewModel}">
            <roomViews:CreateRoomFormView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type roomVm:EditRoomFormViewModel}">
            <roomViews:EditRoomFormView />
        </DataTemplate>
        
        <!-- Room Detail related pages-->
        <DataTemplate DataType="{x:Type roomdetailVm:RoomDetailViewModel }">
            <roomDetailViews:RoomDetailView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Column 0: Sidebar Panel (Uncovered) -->
        <Border Grid.Column="0"
                Background="{DynamicResource CardBackground}" 
                Panel.ZIndex="1">
            <Border.Effect>
                <DropShadowEffect Direction="0" BlurRadius="15" ShadowDepth="4" Opacity="0.1" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,10,0,0">
                    <!-- App Title Logo Header -->
                    <StackPanel Margin="10,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Image/tht_logo.png" Width="50" Height="50"/>
                        <TextBlock Text="Hostel Management System" 
                                   Foreground="{DynamicResource TextPrimary}" 
                                   FontWeight="Bold" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Navigation Items -->
                    <RadioButton Content="Dashboard"
                                 GroupName="SidebarNav"
                                 Style="{StaticResource SidebarItemStyle}"
                                 IsChecked="True"
                                 Command="{Binding NavigateToDashboardCommand}"
                                 Tag="M3,4 A1,1 0 0,1 4,3 H9 A1,1 0 0,1 10,4 V11 A1,1 0 0,1 9,12 H4 A1,1 0 0,1 3,11 Z M14,4 A1,1 0 0,1 15,3 H20 A1,1 0 0,1 21,4 V7 A1,1 0 0,1 20,8 H15 A1,1 0 0,1 14,7 Z M14,13 A1,1 0 0,1 15,12 H20 A1,1 0 0,1 21,13 V20 A1,1 0 0,1 20,21 H15 A1,1 0 0,1 14,20 Z M3,17 A1,1 0 0,1 4,16 H9 A1,1 0 0,1 10,17 V20 A1,1 0 0,1 9,21 H4 A1,1 0 0,1 3,20 Z"/>

                    <RadioButton Content="အဆောင်နေသူများ"
                                 GroupName="SidebarNav"
                                 Style="{StaticResource SidebarItemStyle}"
                                 Command="{Binding NavigateToResidentCommand}"
                                 Tag="M320,312 C386.3,312 440,258.3 440,192 C440,125.7 386.3,72 320,72 C253.7,72 200,125.7 200,192 C200,258.3 253.7,312 320,312 Z M290.3,368 C191.8,368 112,447.8 112,546.3 C112,562.7 125.3,576 141.7,576 L498.3,576 C514.7,576 528,562.7 528,546.3 C528,447.8 448.2,368 349.7,368 L290.3,368 Z"/>

                    <RadioButton Content="အဆောင်အခန်းများ"
                                 GroupName="SidebarNav"
                                 Style="{StaticResource SidebarItemStyle}"
                                 Command="{Binding NavigateToBuildingCommand}"
                                 Tag="M4,22 V2 H20 V22 H14 V16 H10 V22 Z M8,6 H10 V8 H8 Z M14,6 H16 V8 H14 Z M8,11 H10 V13 H8 Z M14,11 H16 V13 H14 Z"/>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                    <RadioButton Content="Setting"
                                 GroupName="SidebarNav"
                                 Style="{StaticResource SidebarItemStyle}"
                                 Command="{Binding NavigateToSettingCommand}"
                                 Margin="10 0 10 10"
                                 Tag="M9.671,4.136 A2.34,2.34 0 0,1 14.33,4.136 A2.34,2.34 0 0,0 17.649,6.051 A2.34,2.34 0 0,1 19.979,10.084 A2.34,2.34 0 0,0 19.979,13.915 A2.34,2.34 0 0,1 17.649,17.948 A2.34,2.34 0 0,0 14.33,19.863 A2.34,2.34 0 0,1 9.671,19.863 A2.34,2.34 0 0,0 6.351,17.948 A2.34,2.34 0 0,1 4.021,13.915 A2.34,2.34 0 0,0 4.021,10.084 A2.34,2.34 0 0,1 6.351,6.051 A2.34,2.34 0 0,0 9.671,4.136 Z M12,9 A3,3 0 1,1 12,15 A3,3 0 1,1 12,9 Z"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Column 1: Container wrapping Main Content & Loading Overlay -->
        <Grid Grid.Column="1">
            <!-- Main Content View Frame -->
            <Border Background="{DynamicResource WindowBackground}">
                <ContentControl Content="{Binding CurrentView}" Margin="20"/>
            </Border>

            <!-- Loading Spinner Overlay (Applies ONLY to Column 1) -->
            <Grid Background="#80000000"
                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                  Panel.ZIndex="999">

                <Border HorizontalAlignment="Center" 
                        VerticalAlignment="Center" 
                        Background="{DynamicResource CardBackground}" 
                        CornerRadius="12" 
                        Padding="30,25">
                    <Border.Effect>
                        <DropShadowEffect Direction="0" BlurRadius="20" ShadowDepth="4" Opacity="0.2" Color="#000000"/>
                    </Border.Effect>

                    <StackPanel HorizontalAlignment="Center">
                        <!-- Spinner Icon -->
                        <Viewbox Width="50" Height="50" Margin="0,0,0,15">
                            <Grid Width="48" Height="48">
                                <Ellipse Stroke="#E0E0E0" StrokeThickness="4" />
                                <Path Stroke="#007ACC" 
                                      StrokeThickness="4" 
                                      StrokeStartLineCap="Round" 
                                      StrokeEndLineCap="Round"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.Data>
                                        <PathGeometry>
                                            <PathFigure StartPoint="24,2">
                                                <ArcSegment Point="46,24" Size="22,22" SweepDirection="Clockwise" />
                                            </PathFigure>
                                        </PathGeometry>
                                    </Path.Data>
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="SpinnerRotation" Angle="0" />
                                    </Path.RenderTransform>
                                    <Path.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                                                                     Storyboard.TargetProperty="Angle"
                                                                     From="0" To="360" 
                                                                     Duration="0:0:0.9" 
                                                                     RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Path.Triggers>
                                </Path>
                            </Grid>
                        </Viewbox>

                        <!-- Busy Text Readout -->
                        <TextBlock Text="{Binding BusyText}" 
                                   FontSize="14" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimary}" 
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>