                    <RadioButton
                        Command="{Binding NavigateToCommand}"
                        CommandParameter="DataTransfer"
                        Content="ဒေတာလွှဲပြောင်းခြင်း"
                        GroupName="SidebarNav"
                        Style="{StaticResource SidebarItemStyle}"
                        Tag="M12,3C7.58,3 4,4.79 4,7V17C4,19.21 7.58,21 12,21C16.42,21 20,19.21 20,17V7C20,4.79 16.42,3 12,3ZM18,17C18,17.5 15.87,19 12,19C8.13,19 6,17.5 6,17V14.77C7.61,15.55 9.72,16 12,16C14.28,16 16.39,15.55 18,14.77V17ZM18,12.5C16.39,13.28 14.28,13.73 12,13.73C9.72,13.73 7.61,13.28 6,12.5V9.77C7.61,10.55 9.72,11 12,11C14.28,11 16.39,10.55 18,9.77V12.5ZM12,5C15.87,5 18,6.5 18,7C18,7.5 15.87,9 12,9C8.13,9 6,7.5 6,7C6,6.5 8.13,5 12,5Z" />
                    <RadioButton
                        Margin="10,0,10,10"
                        Command="{Binding NavigateToCommand}"
                        CommandParameter="Setting"
                        Content="Setting"
                        GroupName="SidebarNav"
                        Style="{StaticResource SidebarItemStyle}"
                        Tag="M9.671,4.136 A2.34,2.34 0 0,1 14.33,4.136 A2.34,2.34 0 0,0 17.649,6.051 A2.34,2.34 0 0,1 19.979,10.084 A2.34,2.34 0 0,0 19.979,13.915 A2.34,2.34 0 0,1 17.649,17.948 A2.34,2.34 0 0,0 14.33,19.863 A2.34,2.34 0 0,1 9.671,19.863 A2.34,2.34 0 0,0 6.351,17.948 A2.34,2.34 0 0,1 4.021,13.915 A2.34,2.34 0 0,0 4.021,10.084 A2.34,2.34 0 0,1 6.351,6.051 A2.34,2.34 0 0,0 9.671,4.136 Z M12,9 A3,3 0 1,1 12,15 A3,3 0 1,1 12,9 Z" />

                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                    <Border
                        Height="80"
                        Margin="10,0,10,10"
                        Padding="10,6"
                        HorizontalAlignment="Stretch"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0.0" Color="#055035" />
                                <GradientStop Offset="1.0" Color="#0BB679" />
                            </LinearGradientBrush>
                        </Border.Background>

                        <StackPanel>
                            <TextBlock
                                HorizontalAlignment="Left"
                                FontSize="11"
                                Foreground="White"
                                Text="လိုင်စင်သက်တမ်း" />

                            <TextBlock
                                Margin="0,8,0,0"
                                HorizontalAlignment="Left"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="{Binding LicenseRemainingText}" />
                        </StackPanel>


                    </Border>


                    <ToggleButton
                        Margin="10,0,10,15"
                        IsChecked="{Binding IsDarkMode, Mode=TwoWay}"
                        Style="{StaticResource ThemeToggleStyle}"
                        ToolTip="Switch theme" />

                    <Border
                        Margin="10,0,10,15"
                        Padding="10,6"
                        HorizontalAlignment="Stretch"
                        BorderThickness="1"
                        CornerRadius="6">

                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="{Binding CurrentVersion, StringFormat='Version {0}'}" />

                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Column 1: Container wrapping Main Content & Loading Overlay  -->
        <Grid Grid.Column="1">
            <!--  Main Content View Frame  -->
            <Border Background="{DynamicResource WindowBackground}">
                <ContentControl Margin="16,16,0,16" Content="{Binding CurrentView}" />
            </Border>

            <!--  Loading Spinner Overlay (Applies ONLY to Column 1)  -->
            <Grid
                Panel.ZIndex="999"
                Background="#80000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">

                <Border
                    Padding="30,25"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CardBackground}"
                    CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="20"
                            Direction="0"
                            Opacity="0.2"
                            ShadowDepth="4"
                            Color="#000000" />
                    </Border.Effect>

                    <StackPanel HorizontalAlignment="Center">
                        <!--  Spinner Icon  -->
                        <Viewbox
                            Width="50"
                            Height="50"
                            Margin="0,0,0,15">
                            <Grid Width="48" Height="48">
                                <Ellipse Stroke="#E0E0E0" StrokeThickness="4" />
                                <Path
                                    RenderTransformOrigin="0.5,0.5"
                                    Stroke="#007ACC"
                                    StrokeEndLineCap="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="4">
                                    <Path.Data>
                                        <PathGeometry>
                                            <PathFigure StartPoint="24,2">
                                                <ArcSegment
                                                    Point="46,24"
                                                    Size="22,22"
                                                    SweepDirection="Clockwise" />
                                            </PathFigure>
                                        </PathGeometry>
                                    </Path.Data>
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="SpinnerRotation" Angle="0" />
                                    </Path.RenderTransform>
                                    <Path.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        RepeatBehavior="Forever"
                                                        Storyboard.TargetName="SpinnerRotation"
                                                        Storyboard.TargetProperty="Angle"
                                                        From="0"
                                                        To="360"
                                                        Duration="0:0:0.9" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Path.Triggers>
                                </Path>
                            </Grid>
                        </Viewbox>

                        <!--  Busy Text Readout  -->
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="{Binding BusyText}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>