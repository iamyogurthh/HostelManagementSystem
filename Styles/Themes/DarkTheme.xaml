<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  Dark Mode Surfaces  -->
    <SolidColorBrush x:Key="WindowBackground" Color="#1C1C1E" />
    <SolidColorBrush x:Key="CardBackground" Color="#26262A" />
    <SolidColorBrush x:Key="BorderColor" Color="#333338" />

    <!--  Typography  -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF" />

    <!--  Accent (#055035 Engine)  -->
    <SolidColorBrush x:Key="PrimaryAccent" Color="#055035" />
    <SolidColorBrush x:Key="PrimaryHover" Color="#055035" />
    <SolidColorBrush x:Key="SidebarHoverTint" Color="#15055035" />

    <!--  Aliases for BuildingView and Card Bindings  -->
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="#26262A" />
    <SolidColorBrush x:Key="BorderBrush" Color="#333338" />

    <!--  Progress Bar  -->
    <SolidColorBrush x:Key="ProgressBarForeground" Color="#2D8C6C" />
    <SolidColorBrush x:Key="ProgressBarBackground" Color="#333338" />

</ResourceDictionary>

