<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark Mode Surfaces -->
    <SolidColorBrush x:Key="WindowBackground" Color="#1C1C1E" />
    <SolidColorBrush x:Key="CardBackground" Color="#26262A" />
    <SolidColorBrush x:Key="BorderColor" Color="#333338" />

    <!-- Typography -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF" />

    <!-- Accent (#671EE1 Engine) -->
    <SolidColorBrush x:Key="PrimaryAccent" Color="#671EE1" />
    <SolidColorBrush x:Key="PrimaryHover" Color="#8B5CF6" />
    <SolidColorBrush x:Key="SidebarHoverTint" Color="#25671EE1" />

    <!-- Aliases for BuildingView and Card Bindings -->
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="#26262A" />
    <SolidColorBrush x:Key="BorderBrush" Color="#333338" />
   
</ResourceDictionary>