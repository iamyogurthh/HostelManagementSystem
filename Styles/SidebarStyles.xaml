<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Reusable Gradient Brush for Active Sidebar Items  -->
    <LinearGradientBrush x:Key="SidebarActiveGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="#055035" />
        <GradientStop Offset="1.0" Color="#0BB679" />
    </LinearGradientBrush>

    <!--  Custom Sidebar Navigation Button Style  -->
    <Style x:Key="SidebarItemStyle" TargetType="RadioButton">
        <Setter Property="Height" Value="48" />
        <Setter Property="Margin" Value="10,4,10,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        x:Name="border"
                        Padding="15,0"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <!--  Geometric Vector Icon  -->
                            <Path
                                x:Name="iconPath"
                                Width="18"
                                Height="18"
                                Margin="0,0,12,0"
                                Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                Fill="{TemplateBinding Foreground}"
                                Stretch="Uniform" />

                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!--  Hover Effect  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SidebarHoverTint}" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryHover}" />
                        </Trigger>

                        <!--  Active / Selected Effect  -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource SidebarActiveGradient}" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>