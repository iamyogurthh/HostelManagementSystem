<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:roomDetailViews="clr-namespace:HostelManagementSystem.Views.RoomDetailViews"
    xmlns:roomTypeVM="clr-namespace:HostelManagementSystem.ViewModels.RoomViewModels.RoomTypeViewModels"
    xmlns:roomTypeViews="clr-namespace:HostelManagementSystem.Views.RoomViews.RoomTypeViews"
    xmlns:roomViews="clr-namespace:HostelManagementSystem.Views.RoomViews"
    xmlns:roomVm="clr-namespace:HostelManagementSystem.ViewModels.RoomViewModels"
    xmlns:roomdetailVm="clr-namespace:HostelManagementSystem.ViewModels.RoomDetailViewModels"
    xmlns:studentDetailViews="clr-namespace:HostelManagementSystem.Views.StudentDetailViews"
    xmlns:studentDetailVm="clr-namespace:HostelManagementSystem.ViewModels.StudentDetailViewModels"
    xmlns:studentV="clr-namespace:HostelManagementSystem.Views.StudentViews"
    xmlns:studentVM="clr-namespace:HostelManagementSystem.ViewModels.StudentViewModels"
    xmlns:viewmodels="clr-namespace:HostelManagementSystem.ViewModels"
    xmlns:views="clr-namespace:HostelManagementSystem.Views">

    <!--  Sidebar related pages  -->
    <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
        <views:DashboardView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewmodels:BuildingViewModel}">
        <views:BuildingView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewmodels:ResidentViewModel}">
        <views:ResidentView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewmodels:SettingViewModel}">
        <views:SettingView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewmodels:DataTransferViewModel}">
        <views:DataTransferView />
    </DataTemplate>

    <!--  Building related pages  -->
    <DataTemplate DataType="{x:Type viewmodels:CreateBuildingFormViewModel}">
        <views:CreateBuildingFormView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewmodels:EditBuildingFormViewModel}">
        <views:EditBuildingFormView />
    </DataTemplate>

    <!--  Floor related pages  -->
    <DataTemplate DataType="{x:Type viewmodels:FloorViewModel}">
        <views:FloorView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewmodels:CreateFloorFormViewModel}">
        <views:CreateFloorFormView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewmodels:EditFloorFormViewModel}">
        <views:EditFloorFormView />
    </DataTemplate>

    <!--  Room related pages  -->
    <DataTemplate DataType="{x:Type viewmodels:RoomViewModel}">
        <views:RoomView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type roomVm:CreateRoomFormViewModel}">
        <roomViews:CreateRoomFormView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type roomVm:EditRoomFormViewModel}">
        <roomViews:EditRoomFormView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type roomTypeVM:RoomTypeViewModel}">
        <roomTypeViews:RoomTypeView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type roomTypeVM:RoomTypeFormViewModel}">
        <roomTypeViews:RoomTypeFormView />
    </DataTemplate>

    <!--  Room Detail related pages  -->
    <DataTemplate DataType="{x:Type roomdetailVm:RoomDetailViewModel}">
        <roomDetailViews:RoomDetailView />
    </DataTemplate>

    <!--  Student Create/Edit related pages  -->
    <DataTemplate DataType="{x:Type studentVM:AddNewStudentFormViewModel}">
        <studentV:AddNewStudentFormView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type studentVM:EditStudentFormViewModel}">
        <studentV:EditStudentFormView />
    </DataTemplate>

    <!--  Student Detail related pages  -->
    <DataTemplate DataType="{x:Type studentDetailVm:StudentDetailViewModel}">
        <studentDetailViews:StudentDetailView />
    </DataTemplate>


</ResourceDictionary>