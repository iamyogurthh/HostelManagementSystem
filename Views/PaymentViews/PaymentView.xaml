<UserControl
    x:Class="HostelManagementSystem.Views.PaymentViews.PaymentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:HostelManagementSystem.Models"
    xmlns:vm="clr-namespace:HostelManagementSystem.ViewModels.PaymentViewModels"
    mc:Ignorable="d">

    <UserControl.Resources>

        <!--
            =====================================================
            STATUS BADGE
            =====================================================
        -->

        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </UserControl.Resources>


    <Grid Margin="0,0,16,0">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <!--
            =====================================================
            HEADER & METRIC CARDS
            =====================================================
        -->

        <Grid Grid.Row="0" Margin="0,0,0,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>


            <!--  PAGE TITLE  -->

            <StackPanel Grid.Column="0" VerticalAlignment="Center">

                <TextBlock
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="ငွေပေးချေမှု စီမံခန့်ခွဲမှု" />



            </StackPanel>


            <!--  METRICS  -->

            <StackPanel Grid.Column="1" Orientation="Horizontal">

                <Button
                    Height="42"
                    Margin="8,0,0,0"
                    Padding="16,0"
                    Command="{Binding OpenManualChargeCommand}"
                    Content="အဆောင်ခကောက်ရန်"
                    Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>

        </Grid>

        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,16"
            Orientation="Horizontal">
            <!--  TOTAL OUTSTANDING  -->

            <Border
                Width="160"
                Margin="0,0,10,0"
                Padding="12,10"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="8">

                <StackPanel>

                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="စုစုပေါင်း လက်ကျန်ငွေ" />

                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#E53935"
                        Text="{Binding TotalSystemOutstanding, Mode=OneWay, StringFormat={}{0:N0} MMK, FallbackValue='0 MMK'}" />

                </StackPanel>

            </Border>


            <!--  MONTHLY COLLECTION  -->

            <Border
                Width="160"
                Padding="12,10"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="8">

                <StackPanel>

                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="ယခုလ ရရှိပြီးငွေ" />

                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#4CAF50"
                        Text="{Binding MonthlyCollectedTotal, Mode=OneWay, StringFormat={}{0:N0} MMK, FallbackValue='0 MMK'}" />

                </StackPanel>

            </Border>

            <Button
                Width="48"
                Height="40"
                Margin="16,0,0,0"
                Padding="0"
                Command="{Binding RefreshStudentFinancialDataCommand}"
                Style="{StaticResource SecondaryButtonStyle}"
                ToolTip="Refresh">

                <Button.Triggers>
                    <EventTrigger RoutedEvent="Button.Click">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetName="RefreshIcon"
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                    From="0"
                                    To="720"
                                    Duration="0:0:1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Button.Triggers>

                <Viewbox Width="20" Height="20">
                    <Canvas Width="640" Height="640">
                        <Path
                            x:Name="RefreshIcon"
                            Data="M500.7 138.7L512 149.4L512 96C512 78.3 526.3 64 544 64C561.7 64 576 78.3 576 96L576 224C576 241.7 561.7 256 544 256L416 256C398.3 256 384 241.7 384 224C384 206.3 398.3 192 416 192L463.9 192L456.3 184.8C456.1 184.6 455.9 184.4 455.7 184.2C380.7 109.2 259.2 109.2 184.2 184.2C109.2 259.2 109.2 380.7 184.2 455.7C259.2 530.7 380.7 530.7 455.7 455.7C463.9 447.5 471.2 438.8 477.6 429.6C487.7 415.1 507.7 411.6 522.2 421.7C536.7 431.8 540.2 451.8 530.1 466.3C521.6 478.5 511.9 490.1 501 501C401 601 238.9 601 139 501C39.1 401 39 239 139 139C238.9 39.1 400.7 39 500.7 138.7z"
                            Fill="{DynamicResource TextPrimary}">

                            <Path.RenderTransform>
                                <RotateTransform CenterX="320" CenterY="320" />
                            </Path.RenderTransform>
                        </Path>
                    </Canvas>
                </Viewbox>
            </Button>
        </StackPanel>


        <!--
            =====================================================
            SEARCH TOOLBAR
            =====================================================
        -->

        <Border
            Grid.Row="2"
            Margin="0,0,0,16"
            Padding="12"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1"
            CornerRadius="8">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>


                <!--  SEARCH  -->

                <TextBox
                    Grid.Column="0"
                    Height="38"
                    Margin="0,0,12,0"
                    Padding="10,0"
                    VerticalContentAlignment="Center"
                    FontSize="13"
                    Text="{Binding SearchName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />


                <!--  BUTTONS  -->

                <StackPanel Grid.Column="1" Orientation="Horizontal">

                    <Button
                        Width="90"
                        Height="38"
                        Margin="0,0,8,0"
                        Command="{Binding SearchStudentsCommand}"
                        Content="Search"
                        Style="{StaticResource PrimaryButtonStyle}" />

                    <Button
                        Width="80"
                        Height="38"
                        Command="{Binding ResetSearchCommand}"
                        Content="Clear"
                        Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>

            </Grid>

        </Border>


        <!--
            =====================================================
            MAIN SPLIT VIEW
            =====================================================
        -->

        <Grid Grid.Row="3">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>


            <!--
                =================================================
                LEFT: STUDENT LIST
                =================================================
            -->

            <Border
                Grid.Column="0"
                Padding="12"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="8">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>


                    <!--  TITLE  -->

                    <TextBlock
                        Grid.Row="0"
                        Margin="0,0,0,10"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="ကျောင်းသားစာရင်း" />


                    <!--  STUDENT LIST  -->

                    <ListBox
                        Grid.Row="1"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding Students}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectedItem="{Binding SelectedStudent, Mode=TwoWay}">

                        <ListBox.ItemContainerStyle>

                            <Style TargetType="ListBoxItem">

                                <Setter Property="Padding" Value="0" />

                                <Setter Property="Margin" Value="0,0,0,8" />

                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />

                                <Setter Property="Template">

                                    <Setter.Value>

                                        <ControlTemplate TargetType="ListBoxItem">

                                            <Border
                                                x:Name="ItemBorder"
                                                Padding="12"
                                                Background="{DynamicResource CardBackground}"
                                                BorderBrush="{DynamicResource BorderColor}"
                                                BorderThickness="2"
                                                CornerRadius="6">

                                                <ContentPresenter />

                                            </Border>


                                            <ControlTemplate.Triggers>

                                                <!--  MOUSE OVER  -->

                                                <Trigger Property="IsMouseOver" Value="True">

                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource PrimaryAccent}" />

                                                </Trigger>


                                                <!--  SELECTED  -->

                                                <Trigger Property="IsSelected" Value="True">

                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource WindowBackground}" />

                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource PrimaryAccent}" />

                                                    <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1.5" />

                                                </Trigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>

                            </Style>

                        </ListBox.ItemContainerStyle>


                        <!--  STUDENT ITEM  -->

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>


                                    <!--
                                        =================================================
                                        STUDENT INFORMATION
                                        =================================================
                                    -->

                                    <StackPanel Grid.Column="0" MinWidth="0">

                                        <!--  NAME  -->

                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextPrimary}"
                                            Text="{Binding Name, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />


                                        <!--  NRC  -->

                                        <TextBlock
                                            Margin="0,8,0,4"
                                            FontSize="14"
                                            Foreground="{DynamicResource TextPrimary}"
                                            Text="{Binding NRC, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />


                                        <!--  CURRENT ROOM  -->
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource TextPrimary}"
                                            Text="{Binding CurrentAccommodation.Room.Floor.Building.Name, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource TextPrimary}"
                                            Text="{Binding CurrentAccommodation.Room.Floor.Name, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource TextPrimary}"
                                            Text="{Binding CurrentAccommodation.Room.Name, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />

                                    </StackPanel>


                                    <!--
                                        =================================================
                                        UNPAID BADGE
                                        =================================================
                                    -->

                                    <Border
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Padding="8,3"
                                        VerticalAlignment="Top"
                                        Background="#EF4444"
                                        CornerRadius="12">

                                        <Border.Style>

                                            <Style TargetType="Border">

                                                <!--  Hidden by default  -->

                                                <Setter Property="Visibility" Value="Collapsed" />


                                                <!--  Show when student has unpaid fee  -->

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding IsUnpaid, Mode=OneWay}" Value="True">

                                                        <Setter Property="Visibility" Value="Visible" />

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </Border.Style>


                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="Unpaid" />

                                    </Border>

                                </Grid>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>


                    <!--  PAGINATION  -->

                    <Grid Grid.Row="2" Margin="0,10,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>


                        <!--  PAGE INFO  -->

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondary}">

                            <Run Text="စာမျက်နှာ " />

                            <Run Text="{Binding CurrentPage, Mode=OneWay}" />

                            <Run Text=" / " />

                            <Run Text="{Binding TotalPages, Mode=OneWay}" />

                        </TextBlock>


                        <!--  PAGE BUTTONS  -->

                        <StackPanel Grid.Column="1" Orientation="Horizontal">

                            <Button
                                Width="28"
                                Height="28"
                                Margin="2,0"
                                Command="{Binding FirstPageCommand}"
                                Content="«" />

                            <Button
                                Width="28"
                                Height="28"
                                Margin="2,0"
                                Command="{Binding PreviousPageCommand}"
                                Content="‹" />

                            <Button
                                Width="28"
                                Height="28"
                                Margin="2,0"
                                Command="{Binding NextPageCommand}"
                                Content="›" />

                            <Button
                                Width="28"
                                Height="28"
                                Margin="2,0"
                                Command="{Binding LastPageCommand}"
                                Content="»" />

                        </StackPanel>

                    </Grid>

                </Grid>

            </Border>


            <!--
                =================================================
                SPACER
                =================================================
            -->

            <Grid Grid.Column="1" />


            <!--
                =================================================
                RIGHT: FINANCIAL DETAILS
                =================================================
            -->

            <Border
                Grid.Column="2"
                Padding="16"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="8">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>


                    <!--
                        =================================================
                        SELECTED STUDENT BANNER
                        =================================================
                    -->

                    <Grid Grid.Row="0" Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>


                        <!--  STUDENT INFORMATION  -->

                        <StackPanel Grid.Column="0">

                            <TextBlock
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextPrimary}"
                                Text="{Binding SelectedStudent.Name, Mode=OneWay, FallbackValue='ကျောင်းသား ရွေးချယ်ပါ'}" />


                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">

                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{Binding SelectedStudent.NRC, Mode=OneWay}" />

                                <TextBlock
                                    Margin="8,0,0,0"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextSecondary}">

                                    <Run Text="• " />

                                    <Run Text="{Binding SelectedStudent.StudentCategory.Name, Mode=OneWay}" />

                                </TextBlock>

                            </StackPanel>

                        </StackPanel>


                        <!--  BALANCE  -->

                        <Border
                            Grid.Column="1"
                            Padding="12,8"
                            Background="{DynamicResource WindowBackground}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="6">

                            <StackPanel HorizontalAlignment="Right">

                                <TextBlock
                                    FontSize="10"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="ပေးရန်ကျန်သော အခကြေးငွေ" />

                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="#D32F2F"
                                    Text="{Binding OutstandingBalance, Mode=OneWay, StringFormat={}{0:N0} MMK, FallbackValue='0 MMK'}" />

                            </StackPanel>

                        </Border>

                    </Grid>


                    <!--  DIVIDER  -->

                    <Border
                        Grid.Row="1"
                        Height="1"
                        Margin="0,0,0,12"
                        Background="{DynamicResource BorderColor}" />


                    <!--
                        =================================================
                        CHARGES & PAYMENTS
                        =================================================
                    -->

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="0,0,8,0">


                            <!--
                                =================================================
                                OUTSTANDING CHARGES HEADER
                                =================================================
                            -->

                            <Grid Margin="0,0,0,8">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>


                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Text="ကျန်ရှိသော အခကြေးငွေများ (Fee Charges)" />



                            </Grid>


                            <!-- =================================================
                                 OUTSTANDING FEE CHARGES

                                 ItemsSource:
                                 ObservableCollection<OutstandingChargeItemViewModel>

                                 Therefore this template intentionally
                                 does NOT specify FeeCharge as DataType.
                                 =================================================-->

                            <ItemsControl ItemsSource="{Binding OutstandingCharges}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Border
                                            Margin="0,0,0,8"
                                            Padding="12"
                                            Background="{DynamicResource WindowBackground}"
                                            BorderBrush="{DynamicResource BorderColor}"
                                            BorderThickness="1"
                                            CornerRadius="6">

                                            <Grid>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>


                                                <!--
                                                    =================================
                                                    CHARGE INFORMATION
                                                    =================================
                                                -->

                                                <StackPanel>


                                                    <!--  PERIOD  -->

                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource TextPrimary}">

                                                        <Run Text="{Binding PeriodStart, Mode=OneWay, StringFormat={}{0:dd MMM yyyy}}" />

                                                        <Run Text=" – " />

                                                        <Run Text="{Binding PeriodEnd, Mode=OneWay, StringFormat={}{0:dd MMM yyyy}}" />

                                                    </TextBlock>


                                                    <!--  DUE DATE  -->

                                                    <TextBlock
                                                        Margin="0,3,0,0"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource TextSecondary}">

                                                        <Run Text="သတ်မှတ်ရက်: " />

                                                        <Run Text="{Binding DueDate, Mode=OneWay, StringFormat={}{0:dd MMM yyyy}}" />

                                                    </TextBlock>


                                                    <!--  ORIGINAL AMOUNT  -->

                                                    <TextBlock
                                                        Margin="0,3,0,0"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource TextSecondary}">

                                                        <Run Text="အခကြေးငွေ: " />

                                                        <Run Text="{Binding Amount, Mode=OneWay, StringFormat={}{0:N0} MMK}" />

                                                    </TextBlock>


                                                    <!--  PAID AMOUNT  -->

                                                    <TextBlock
                                                        Margin="0,3,0,0"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource TextSecondary}">

                                                        <Run Text="ပေးပြီးငွေ: " />

                                                        <Run Text="{Binding PaidAmount, Mode=OneWay, StringFormat={}{0:N0} MMK}" />

                                                    </TextBlock>

                                                    <!--  Description  -->

                                                    <TextBlock
                                                        Margin="0,3,0,0"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource TextSecondary}">

                                                        <Run Text="Note: " />

                                                        <Run Text="{Binding Description, Mode=OneWay}" />

                                                    </TextBlock>

                                                </StackPanel>


                                                <!--
                                                    =================================
                                                    REMAINING AMOUNT
                                                    =================================
                                                -->

                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">


                                                    <!--  REMAINING  -->

                                                    <TextBlock
                                                        FontSize="13"
                                                        FontWeight="Bold"
                                                        Foreground="#D32F2F"
                                                        Text="{Binding RemainingAmount, Mode=OneWay, StringFormat={}{0:N0} MMK}" />
                                                </StackPanel>

                                            </Grid>

                                        </Border>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>


                            <!--
                                =================================================
                                PAYMENT HISTORY
                                =================================================
                            -->

                            <!--  PAYMENT HISTORY  -->
                            <TextBlock
                                Margin="0,16,0,8"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimary}"
                                Text="ငွေပေးချေမှုမှတ်တမ်း (Payment History)" />

                            <ItemsControl ItemsSource="{Binding Payments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PaymentItemViewModel}">
                                        <Border
                                            Margin="0,0,0,6"
                                            Padding="10,8"
                                            Background="{DynamicResource WindowBackground}"
                                            BorderBrush="{DynamicResource BorderColor}"
                                            BorderThickness="1"
                                            CornerRadius="6">

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!--  PAYMENT INFORMATION  -->
                                                <StackPanel>

                                                    <!--  RECEIPT NUMBER  -->
                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource TextPrimary}"
                                                        Text="{Binding ReceiptNumber, Mode=OneWay}" />

                                                    <!--  DATE  -->
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource TextSecondary}"
                                                        Text="{Binding PaymentDate, Mode=OneWay, StringFormat={}{0:dd MMM yyyy HH:mm}}" />


                                                    <!--  DYNAMIC COVERAGE PERIOD  -->
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{DynamicResource TextSecondary}"
                                                        Text="{Binding DateRangeText, Mode=OneWay}" />
                                                    <!--  NOTES (If present)  -->
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource TextSecondary}"
                                                        Text="{Binding Notes, Mode=OneWay}" />
                                                </StackPanel>

                                                <!--  PAYMENT AMOUNT & METHOD  -->
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="Bold"
                                                        Foreground="#388E3C"
                                                        Text="{Binding TotalAmount, Mode=OneWay, StringFormat={}{0:N0} MMK}" />

                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        FontSize="10"
                                                        Foreground="{DynamicResource TextSecondary}"
                                                        Text="{Binding PaymentMethod, Mode=OneWay}" />
                                                </StackPanel>

                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                    </ScrollViewer>


                    <!--
                        =================================================
                        RECORD PAYMENT
                        =================================================
                    -->

                    <Grid Grid.Row="3" Margin="0,12,0,0">

                        <Button
                            Height="42"
                            Command="{Binding OpenRecordPaymentDialogCommand}"
                            Content="ငွေလက်ခံမည်"
                            Style="{StaticResource PrimaryButtonStyle}" />

                    </Grid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>