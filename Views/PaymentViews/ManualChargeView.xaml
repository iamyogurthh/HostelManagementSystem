<UserControl
    x:Class="HostelManagementSystem.Views.PaymentViews.ManualChargeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">

        <Grid Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  HEADER  -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="အဆောင်ခ ကောက်ရန်" />

                </StackPanel>

                <Button
                    Grid.Column="1"
                    Height="40"
                    MinWidth="76"
                    Margin="12,0,0,0"
                    VerticalAlignment="Top"
                    Command="{Binding CancelCommand}"
                    Content="Back"
                    Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>

            <!--  DIVIDER  -->
            <Border
                Grid.Row="1"
                Height="1"
                Margin="0,16,0,16"
                Background="{DynamicResource BorderColor}" />

            <!--  ERROR MESSAGE  -->
            <Border
                Grid.Row="2"
                Margin="0,0,0,16"
                Padding="12"
                Background="#FFF3F3"
                BorderBrush="#E53935"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">

                <TextBlock
                    FontSize="12"
                    Foreground="#D32F2F"
                    Text="{Binding ErrorMessage}"
                    TextWrapping="Wrap" />
            </Border>

            <!--  STUDENT SELECTION  -->
            <StackPanel Grid.Row="3" Margin="0,0,0,16">
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="ကျောင်းသား" />

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="200" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Row="0"
                        Grid.Column="0"
                        Height="40"
                        Padding="10,0"
                        VerticalContentAlignment="Center"
                        Text="{Binding StudentSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Button
                        Grid.Row="0"
                        Grid.Column="1"
                        Height="40"
                        MinWidth="90"
                        Margin="8,0,0,0"
                        Padding="14,0"
                        Command="{Binding SearchStudentsCommand}"
                        Content="Search"
                        Style="{StaticResource PrimaryButtonStyle}" />

                    <ListBox
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Margin="0,8,0,0"
                        Padding="4"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        ItemsSource="{Binding Students}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedItem="{Binding SelectedStudent, Mode=TwoWay}">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimary}"
                                        Text="{Binding Name}" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0,8,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextPrimary}"
                                        Text="{Binding NRC}" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextPrimary}"
                                        Text="{Binding StudentCategory.Name}" />

                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </StackPanel>

            <!--  BILLING PERIOD  -->
            <Grid Grid.Row="4" Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,8,0">
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="စတင်ရက်" />

                    <DatePicker Height="40" SelectedDate="{Binding PeriodStart, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="4,0,4,0">
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="ပြီးဆုံးရက်" />

                    <DatePicker Height="40" SelectedDate="{Binding PeriodEnd, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="8,0,0,0">
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="ပေးချေရမည့်ရက်" />

                    <DatePicker Height="40" SelectedDate="{Binding DueDate, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Margin="0,8,0,0"
                    Orientation="Horizontal">
                    <Button
                        Width="76"
                        Height="38"
                        Margin="0,0,8,0"
                        Command="{Binding SetBillingPeriodCommand}"
                        CommandParameter="1"
                        Content="၁ လစာ"
                        FontSize="12"
                        Style="{StaticResource SecondaryButtonStyle}" />
                    <Button
                        Width="76"
                        Height="38"
                        Margin="0,0,8,0"
                        Command="{Binding SetBillingPeriodCommand}"
                        CommandParameter="2"
                        Content="၂ လစာ"
                        FontSize="12"
                        Style="{StaticResource SecondaryButtonStyle}" />
                    <Button
                        Width="76"
                        Height="38"
                        Margin="0,0,8,0"
                        Command="{Binding SetBillingPeriodCommand}"
                        CommandParameter="3"
                        Content="၃ လစာ"
                        FontSize="12"
                        Style="{StaticResource SecondaryButtonStyle}" />
                    <Button
                        Width="76"
                        Height="38"
                        Margin="0,0,8,0"
                        Command="{Binding SetBillingPeriodCommand}"
                        CommandParameter="6"
                        Content="၆ လစာ"
                        FontSize="12"
                        Style="{StaticResource SecondaryButtonStyle}" />
                    <Button
                        Width="76"
                        Height="38"
                        Command="{Binding SetBillingPeriodCommand}"
                        CommandParameter="12"
                        Content="၁၂ လစာ"
                        FontSize="12"
                        Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </Grid>

            <!--  FEE RULE AND AMOUNT  -->
            <Grid Grid.Row="5" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="အခန်းခနှုန်းထားများ"
                        TextWrapping="Wrap" />

                    <ComboBox
                        Height="40"
                        VerticalContentAlignment="Center"
                        ItemsSource="{Binding FeeRules}"
                        SelectedItem="{Binding SelectedFeeRule, Mode=TwoWay}">

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding StudentCategory.Name}" />
                                    <Run Text=" / " />
                                    <Run Text="{Binding RoomType.Name}" />
                                    <Run Text=" - " />
                                    <Run Text="{Binding MonthlyAmount, StringFormat={}{0:N0}}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="စုစုပေါင်းအခကြေးငွေ *" />

                    <TextBox
                        Height="40"
                        Padding="10,0"
                        VerticalContentAlignment="Center"
                        Text="{Binding Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <!--  DESCRIPTION  -->
            <StackPanel Grid.Row="6" Margin="0,0,0,16">
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="အကြောင်းအရာ" />

                <TextBox
                    MinHeight="80"
                    Padding="10"
                    AcceptsReturn="True"
                    Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
            </StackPanel>

            <!--  INFORMATION  -->
            <Border
                Grid.Row="7"
                Margin="0,0,0,16"
                Padding="12"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="6">

                <TextBlock
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="ရွေးချယ်ထားသောကာလအတွင်းရှိ မပေးရသေးသော အခကြေးငွေများကို ဤစုစုပေါင်းအခကြေးငွေဖြင့် အစားထိုးပါမည်။ ပေးချေပြီးသားအခကြေးငွေများကို အစားထိုး၍မရပါ။"
                    TextWrapping="Wrap" />
            </Border>

            <!--  ACTIONS  -->
            <StackPanel
                Grid.Row="8"
                Margin="0,0,0,16"
                HorizontalAlignment="Left"
                Orientation="Horizontal">

                <Button
                    Height="40"
                    MinWidth="150"
                    Margin="0,0,12,0"
                    Command="{Binding SaveCommand}"
                    Content="အခကြေးငွေသိမ်းမည်"
                    FontSize="12"
                    Style="{StaticResource PrimaryButtonStyle}" />

                <Button
                    Height="40"
                    MinWidth="100"
                    Command="{Binding CancelCommand}"
                    Content="ပယ်ဖျက်ရန်"
                    FontSize="12"
                    Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
