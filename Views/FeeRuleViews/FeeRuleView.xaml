<UserControl
    x:Class="HostelManagementSystem.Views.FeeRuleViews.FeeRuleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:HostelManagementSystem.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="750"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <converters:FeeRuleStatusConverter x:Key="FeeRuleStatusConverter" />

    </UserControl.Resources>

    <Grid>

        <!--  =====================================================  -->
        <!--  MAIN CONTENT  -->
        <!--  =====================================================  -->

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="0,0,16,0">

                <!--  =================================================  -->
                <!--  HEADER  -->
                <!--  =================================================  -->

                <Grid Margin="0,0,0,16">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="အခန်းခနှုန်းထားများ" />

                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="အခန်းအမျိုးအစားနှင့် ကျောင်းသားအမျိုးအစားအလိုက် အခန်းခနှုန်းထားများ" />

                    </StackPanel>

                    <!--  ADD BUTTON  -->

                    <Button
                        Grid.Column="1"
                        Height="48"
                        Command="{Binding OpenCreateFeeRuleFormCommand}"
                        Content="+ အခန်းခနှုန်းထားအသစ်"
                        Style="{StaticResource PrimaryButtonStyle}" />

                </Grid>


                <!--  =================================================  -->
                <!--  FILTER PANEL  -->
                <!--  =================================================  -->

                <Border Margin="0,0,0,16" CornerRadius="8">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  FROM DATE  -->

                        <StackPanel
                            Grid.Column="0"
                            Margin="0,0,12,0"
                            VerticalAlignment="Bottom">

                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="{DynamicResource TextPrimary}"
                                Text="စတင်သည့်နေ့" />

                            <DatePicker Height="38" SelectedDate="{Binding FilterFromDate, Mode=TwoWay}" />

                        </StackPanel>


                        <!--  TO DATE  -->

                        <StackPanel
                            Grid.Column="1"
                            Margin="0,0,12,0"
                            VerticalAlignment="Bottom">

                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="{DynamicResource TextPrimary}"
                                Text="အဆုံးသတ်သည့်နေ့" />

                            <DatePicker Height="38" SelectedDate="{Binding FilterToDate, Mode=TwoWay}" />

                        </StackPanel>


                        <!--  STATUS  -->

                        <StackPanel
                            Grid.Column="2"
                            Margin="0,0,12,0"
                            VerticalAlignment="Bottom">

                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="{DynamicResource TextPrimary}"
                                Text="အခြေအနေ" />

                            <ComboBox
                                Height="38"
                                ItemsSource="{Binding StatusOptions}"
                                SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" />

                        </StackPanel>


                        <!--  SEARCH  -->

                        <Button
                            Grid.Column="3"
                            Height="38"
                            Margin="0,20,8,0"
                            Padding="16,0"
                            VerticalContentAlignment="Center"
                            Command="{Binding ApplyFilterCommand}"
                            Content="Search"
                            Style="{StaticResource PrimaryButtonStyle}" />


                        <!--  CLEAR  -->

                        <Button
                            Grid.Column="4"
                            Height="38"
                            Margin="0,20,0,0"
                            Padding="16,0"
                            VerticalContentAlignment="Center"
                            Command="{Binding ClearFilterCommand}"
                            Content="Clear"
                            Style="{StaticResource SecondaryButtonStyle}" />

                    </Grid>

                </Border>


                <!--  =================================================  -->
                <!--  FEE RULE TABLE  -->
                <!--  =================================================  -->

                <Border
                    Background="White"
                    BorderBrush="{DynamicResource PrimaryAccent}"
                    BorderThickness="1"
                    CornerRadius="8">

                    <Grid>

                        <DataGrid
                            AutoGenerateColumns="False"
                            Background="Transparent"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserReorderColumns="False"
                            CanUserResizeRows="False"
                            ColumnWidth="*"
                            GridLinesVisibility="Horizontal"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding FeeRules}"
                            RowHeight="54">

                            <DataGrid.Columns>

                                <!--  STUDENT CATEGORY  -->

                                <DataGridTextColumn
                                    Width="1.5*"
                                    Binding="{Binding StudentCategory.Name}"
                                    Header="ကျောင်းသားအမျိုးအစား" />


                                <!--  ROOM TYPE  -->

                                <DataGridTextColumn
                                    Width="1.3*"
                                    Binding="{Binding RoomType.Name}"
                                    Header="အခန်းအမျိုးအစား" />


                                <!--  MONTHLY FEE  -->

                                <DataGridTextColumn
                                    Width="1.2*"
                                    Binding="{Binding MonthlyAmount, StringFormat={}{0:N0} ကျပ်}"
                                    Header="လစဉ်ကြေး">

                                    <DataGridTextColumn.ElementStyle>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="VerticalAlignment" Value="Center" />

                                            <Setter Property="FontWeight" Value="SemiBold" />

                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryAccent}" />

                                        </Style>

                                    </DataGridTextColumn.ElementStyle>

                                </DataGridTextColumn>


                                <!--  EFFECTIVE FROM  -->

                                <DataGridTextColumn
                                    Width="1.2*"
                                    Binding="{Binding EffectiveFrom, StringFormat={}{0:dd/MM/yyyy}}"
                                    Header="စတင်သည့်နေ့" />


                                <!--  EFFECTIVE TO  -->

                                <DataGridTextColumn
                                    Width="1.2*"
                                    Binding="{Binding EffectiveTo, StringFormat={}{0:dd/MM/yyyy}}"
                                    Header="အဆုံးသတ်သည့်နေ့">

                                    <DataGridTextColumn.ElementStyle>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="VerticalAlignment" Value="Center" />

                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />

                                        </Style>

                                    </DataGridTextColumn.ElementStyle>

                                </DataGridTextColumn>


                                <!--  STATUS  -->

                                <DataGridTemplateColumn Width="1.1*" Header="အခြေအနေ">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <Border
                                                Padding="10,4"
                                                HorizontalAlignment="Left"
                                                Background="{Binding Converter={StaticResource FeeRuleStatusConverter}, ConverterParameter=Background}"
                                                CornerRadius="12">

                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{Binding Converter={StaticResource FeeRuleStatusConverter}, ConverterParameter=Foreground}"
                                                    Text="{Binding Converter={StaticResource FeeRuleStatusConverter}}" />

                                            </Border>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>


                                <!--  ACTIONS  -->

                                <DataGridTemplateColumn Width="110" Header="လုပ်ဆောင်ချက်များ">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">

                                                <ui:Button
                                                    Width="32"
                                                    Height="32"
                                                    Padding="0"
                                                    Command="{Binding DataContext.DeleteFeeRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Icon="{ui:SymbolIcon Delete24}"
                                                    IsEnabled="{Binding IsActive}"
                                                    Style="{StaticResource DeleteActionButtonStyle}"
                                                    ToolTip="ပိတ်ရန်" />

                                            </StackPanel>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                </Border>


                <!--  =================================================  -->
                <!--  PAGINATION BAR  -->
                <!--  Same design as ResidentView  -->
                <!--  =================================================  -->

                <Grid Margin="0,16,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>


                    <!--  LEFT: RECORDS INFO & PAGE SIZE  -->

                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}">

                            <Run Text="စုစုပေါင်း စာရင်း :" />

                            <Run
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextPrimary}"
                                Text="{Binding TotalFilteredCount, Mode=OneWay}" />

                            <Run Text=" ခု" />

                        </TextBlock>


                        <StackPanel
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">

                            <TextBlock
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="တစ်မျက်နှာလျှင် :" />

                            <ComboBox
                                Width="70"
                                ItemsSource="{Binding PageSizeOptions}"
                                SelectedItem="{Binding PageSize}" />

                        </StackPanel>

                    </StackPanel>


                    <!--  RIGHT: NAVIGATION BUTTONS  -->

                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                        <!--  FIRST  -->

                        <Button
                            Margin="0,0,4,0"
                            Padding="10,6"
                            Command="{Binding FirstPageCommand}"
                            Content="«"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="ပထမဆုံး မျက်နှာဖုံး" />


                        <!--  PREVIOUS  -->

                        <Button
                            Margin="0,0,4,0"
                            Padding="10,6"
                            Command="{Binding PreviousPageCommand}"
                            Content="‹"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="ရှေ့သို့" />


                        <!--  CURRENT PAGE  -->

                        <TextBlock
                            Margin="10,0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}">

                            <Run Text="{Binding CurrentPage, Mode=OneWay}" />

                            <Run Text=" / " />

                            <Run Text="{Binding TotalPages, Mode=OneWay}" />

                        </TextBlock>


                        <!--  NEXT  -->

                        <Button
                            Margin="4,0,0,0"
                            Padding="10,6"
                            Command="{Binding NextPageCommand}"
                            Content="›"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="နောက်သို့" />


                        <!--  LAST  -->

                        <Button
                            Margin="4,0,0,0"
                            Padding="10,6"
                            Command="{Binding LastPageCommand}"
                            Content="»"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="နောက်ဆုံး မျက်နှာဖုံး" />

                    </StackPanel>

                </Grid>


                <!--  =================================================  -->
                <!--  EMPTY STATE  -->
                <!--  =================================================  -->

                <Border
                    Margin="0,16,0,0"
                    Padding="40"
                    Background="{DynamicResource CardBackground}"
                    CornerRadius="8"
                    Visibility="{Binding HasNoFeeRules, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <StackPanel HorizontalAlignment="Center">

                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="အခန်းခနှုန်းထား မရှိပါ" />

                        <TextBlock
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="သတ်မှတ်ထားသော စစ်ထုတ်မှုအရ အခန်းခနှုန်းထား မတွေ့ရှိပါ။" />

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>


        <!--  =====================================================  -->
        <!--  LOADING OVERLAY  -->
        <!--  =====================================================  -->

        <Border Background="#66FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">

            <Border
                Padding="24,18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                BorderBrush="{DynamicResource PrimaryAccent}"
                BorderThickness="1"
                CornerRadius="8">

                <StackPanel HorizontalAlignment="Center">

                    <ProgressBar
                        Width="180"
                        Height="6"
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource PrimaryAccent}"
                        IsIndeterminate="True" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="14"
                        FontWeight="Medium"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="အချက်အလက်များ ရယူနေပါသည်..." />

                </StackPanel>

            </Border>

        </Border>

    </Grid>

</UserControl>