<UserControl
    x:Class="HostelManagementSystem.Views.FeeRuleViews.FeeRuleFormView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="700"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">

        <Grid Margin="0,0,16,0" HorizontalAlignment="Stretch">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <!--
                =====================================================
                1. HEADER
                =====================================================
            -->

            <StackPanel Grid.Row="0" Margin="0,0,0,16">

                <TextBlock
                    Margin="0,0,0,10"
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="{Binding Title}" />

                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="14"
                    Foreground="{DynamicResource PrimaryAccent}"
                    Text="အခန်းခနှုန်းထားအသစ် သတ်မှတ်ခြင်း" />

            </StackPanel>


            <!--
                =====================================================
                SECTION DIVIDER
                =====================================================
            -->

            <Border
                Grid.Row="1"
                Height="1"
                Margin="0,0,0,16"
                Background="Gray" />


            <!--
                =====================================================
                2. ERROR MESSAGE
                =====================================================
            -->

            <TextBlock
                Grid.Row="2"
                Margin="0,0,0,15"
                FontSize="13"
                Foreground="#EF4444"
                Text="{Binding ErrorMessage}"
                TextWrapping="Wrap" />


            <!--
                =====================================================
                3. FORM CONTENT
                =====================================================
            -->

            <StackPanel Grid.Row="3" Margin="0,0,0,30">


                <!--
                    =================================================
                    INFORMATION NOTE
                    =================================================
                -->

                <Border
                    Margin="0,0,0,24"
                    Padding="16"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource PrimaryAccent}"
                    BorderThickness="1"
                    CornerRadius="8">

                    <StackPanel>

                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="သတိပြုရန်*" />

                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="13"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="အခန်းခနှုန်းထားကို သိမ်းဆည်းပြီးနောက် ပြင်ဆင်၍မရပါ။ နှုန်းထားပြောင်းလဲလိုပါက အခန်းခနှုန်းထားအသစ်တစ်ခု ထပ်မံသတ်မှတ်ပါ။"
                            TextWrapping="Wrap" />

                    </StackPanel>

                </Border>


                <!--
                    =================================================
                    STUDENT CATEGORY
                    =================================================
                -->

                <Grid Margin="0,0,0,20">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="ကျောင်းသား အမျိုးအစား *" />

                    <ComboBox
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding StudentCategories}"
                        SelectedItem="{Binding SelectedStudentCategory, Mode=TwoWay}" />

                </Grid>


                <!--
                    =================================================
                    ROOM TYPE
                    =================================================
                -->

                <Grid Margin="0,0,0,20">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="အခန်း အမျိုးအစား *" />

                    <ComboBox
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding RoomTypes}"
                        SelectedItem="{Binding SelectedRoomType, Mode=TwoWay}" />

                </Grid>


                <!--
                    =================================================
                    MONTHLY AMOUNT
                    =================================================
                -->

                <Grid Margin="0,0,0,20">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="လစဉ်ကြေး *" />

                    <TextBox
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource TextBoxStyle}"
                        Text="{Binding MonthlyAmount, UpdateSourceTrigger=PropertyChanged}" />

                </Grid>


                <!--
                    =================================================
                    EFFECTIVE FROM
                    =================================================
                -->

                <Grid Margin="0,0,0,20">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="စတင်အကျိုးသက်ရောက်သည့်နေ့ *" />

                    <DatePicker
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        SelectedDate="{Binding EffectiveFrom, Mode=TwoWay}" />

                </Grid>


                <!--
                    =================================================
                    EFFECTIVE TO
                    =================================================
                -->

                <Grid Margin="0,0,0,20">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="အဆုံးသတ်အကျိုးသက်ရောက်သည့်နေ့" />

                    <DatePicker
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        SelectedDate="{Binding EffectiveTo, Mode=TwoWay}" />

                </Grid>

            </StackPanel>


            <!--
                =====================================================
                4. FORM ACTIONS
                =====================================================
            -->

            <StackPanel
                Grid.Row="4"
                HorizontalAlignment="Left"
                Orientation="Horizontal">

                <Button
                    Margin="0,0,12,0"
                    Command="{Binding SaveCommand}"
                    Content="သိမ်းဆည်းမည်"
                    Style="{StaticResource PrimaryButtonStyle}" />

                <Button
                    Command="{Binding CancelCommand}"
                    Content="မလုပ်တော့ပါ"
                    Style="{StaticResource SecondaryButtonStyle}" />

            </StackPanel>

        </Grid>

    </ScrollViewer>

</UserControl>