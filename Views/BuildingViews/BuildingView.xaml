<UserControl
    x:Class="HostelManagementSystem.Views.BuildingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,16,0">
            <!--  Header Title  -->
            <TextBlock
                Margin="0,0,0,16"
                FontSize="24"
                FontWeight="Bold"
                Foreground="{DynamicResource TextPrimary}"
                Text="အဆောင်စီမံခန့်ခွဲမှု" />

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="အဆောင်များ" />

                <Button
                    Grid.Column="1"
                    Height="48"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding OpenCreateBuildingFormCommand}"
                    Content="+ အဆောင်အသစ်"
                    Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>

            <!--  Main Content Area  -->
            <Grid>
                <!--  1. Empty State Indicator  -->
                <StackPanel
                    Margin="0,60,0,60"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasNoBuildings, Converter={StaticResource BoolToVisConverter}, Mode=OneWay}">
                    <Border
                        Width="80"
                        Height="80"
                        Margin="0,0,0,16"
                        HorizontalAlignment="Center"
                        Background="#F3F4F6"
                        CornerRadius="40">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="36"
                            Text="🏢" />
                    </Border>

                    <TextBlock
                        Margin="0,0,0,6"
                        HorizontalAlignment="Center"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="အဆောင်များ မရှိသေးပါ" />

                    <TextBlock
                        Margin="0,0,0,20"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="အဆောင်အသစ် ထည့်သွင်းရန် '+ အဆောင်အသစ်' ခလုတ်ကို နှိပ်ပါ။" />

                    <Button
                        HorizontalAlignment="Center"
                        Command="{Binding OpenCreateBuildingFormCommand}"
                        Content="+ အဆောင်အသစ် ထည့်ရန်"
                        Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>

                <!--  2. Buildings Grid (Shown when HasBuildings is True)  -->
                <ItemsControl ItemsSource="{Binding Buildings}" Visibility="{Binding HasBuildings, Converter={StaticResource BoolToVisConverter}, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!--  Card Container with Natural Height Sizing  -->
                            <Border Width="210" Style="{StaticResource InteractiveCardStyle}">

                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="12"
                                        Direction="270"
                                        Opacity="0.08"
                                        ShadowDepth="3"
                                        Color="#000000" />
                                </Border.Effect>

                                <Border.InputBindings>
                                    <MouseBinding
                                        Command="{Binding DataContext.SelectBuildingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        MouseAction="LeftClick" />
                                </Border.InputBindings>

                                <StackPanel>
                                    <!--  Fixed 16:9 Image Preview Area (Width: 194px, Height: 120px)  -->
                                    <Grid Height="120">
                                        <!--  Border.Background with ImageBrush clips perfectly to rounded corners  -->
                                        <Border CornerRadius="6,6,0,0">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Img, TargetNullValue='pack://application:,,,/Image/DefaultImages/default_building.png'}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>

                                        <!--  Floating Action Buttons  -->
                                        <StackPanel
                                            Margin="6"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Orientation="Horizontal">

                                            <!--  Edit Button  -->
                                            <Button
                                                Height="26"
                                                Margin="0,0,4,0"
                                                Background="#CC000000"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.OpenEditBuildingFormCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                FontSize="11"
                                                Foreground="White"
                                                ToolTip="ပြင်ဆင်ရန်">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="13" />
                                                    </Style>
                                                </Button.Resources>
                                                <Path
                                                    Width="10"
                                                    Height="10"
                                                    Data="M14.06 2.226a1.75 1.75 0 00-2.474 0L3.75 10.061V12.5h2.439l7.871-7.836a1.75 1.75 0 000-2.438zM2.5 14h11v1.5h-11V14z"
                                                    Fill="White"
                                                    Stretch="Uniform" />
                                            </Button>

                                            <!--  Delete Button  -->
                                            <Button
                                                Height="26"
                                                Background="#CC000000"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.DeleteBuildingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                FontSize="11"
                                                Foreground="#FF6B6B"
                                                ToolTip="ဖျက်ရန်">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="13" />
                                                    </Style>
                                                </Button.Resources>
                                                <Path
                                                    Width="10"
                                                    Height="10"
                                                    Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                                    Fill="#FF6B6B"
                                                    Stretch="Uniform" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <!--  Text Section  -->
                                    <TextBlock
                                        Margin="4,10,4,4"
                                        HorizontalAlignment="Left"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimary}"
                                        Text="{Binding Name}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>