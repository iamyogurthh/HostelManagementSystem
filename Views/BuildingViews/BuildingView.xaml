<UserControl x:Class="HostelManagementSystem.Views.BuildingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Loaded="UserControl_Loaded"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <!-- Header Title -->
            <TextBlock Text="အဆောင်စီမံခန့်ခွဲမှု" 
                       FontSize="24" 
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,20"/>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="အဆောင်များ" 
                           Grid.Column="0"
                           FontSize="18" 
                           FontWeight="SemiBold"
                           Foreground="#671EE1"
                           VerticalAlignment="Center" />

                <Button Content="+ အဆောင်အသစ်"
                        Grid.Column="1"
                        Style="{StaticResource PrimaryButtonStyle}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Command="{Binding OpenCreateBuildingFormCommand}" />
            </Grid>

            <!-- Main Content Area -->
            <Grid>
                <!-- 1. Empty State Indicator -->
                <StackPanel Visibility="{Binding HasNoBuildings, Converter={StaticResource BoolToVisConverter}, Mode=OneWay}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,60,0,60">
                                    <Border Width="80" 
                            Height="80" 
                            CornerRadius="40" 
                            Background="#F3F4F6" 
                            HorizontalAlignment="Center" 
                            Margin="0,0,0,16">
                                        <TextBlock Text="🏢" 
                                   FontSize="36" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center" />
                                    </Border>

                                    <TextBlock Text="အဆောင်များ မရှိသေးပါ" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimary}" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,6" />

                                    <TextBlock Text="အဆောင်အသစ် ထည့်သွင်းရန် '+ အဆောင်အသစ်' ခလုတ်ကို နှိပ်ပါ။" 
                               FontSize="13" 
                               Foreground="{DynamicResource TextSecondary}" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,20" />

                            <Button Content="+ အဆောင်အသစ် ထည့်ရန်"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Center"
                            Command="{Binding OpenCreateBuildingFormCommand}" />    
                </StackPanel>

                <!-- 2. Buildings Grid (Shown when HasBuildings is True) -->
                <ItemsControl ItemsSource="{Binding Buildings}"
                              Visibility="{Binding HasBuildings, Converter={StaticResource BoolToVisConverter}, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Card Container with Natural Height Sizing -->
                            <Border Width="210" 
                                    Style="{StaticResource InteractiveCardStyle}"
                            >

                                <Border.Effect>
                                    <DropShadowEffect Direction="270" BlurRadius="12" ShadowDepth="3" Opacity="0.08" Color="#000000"/>
                                </Border.Effect>

                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" 
                                                  Command="{Binding DataContext.SelectBuildingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                  CommandParameter="{Binding}" />
                                </Border.InputBindings>

                                <StackPanel>
                                    <!-- Fixed 16:9 Image Preview Area (Width: 194px, Height: 120px) -->
                                    <Grid Height="120">
                                        <Border CornerRadius="6" ClipToBounds="True">
                                            <Image Stretch="UniformToFill"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">          
                                                <Image.Source>
                                                    <BitmapImage UriSource="{Binding Img, TargetNullValue='pack://application:,,,/Image/DefaultImages/default_building.png'}" 
                                                                 DecodePixelWidth="300" 
                                                                 CacheOption="OnLoad" />        
                                                </Image.Source>
                                            </Image>
                                        </Border>

                                        <!-- Floating Action Buttons -->
                                        <StackPanel Orientation="Horizontal" 
                                                    HorizontalAlignment="Right" 
                                                    VerticalAlignment="Top" 
                                                    Margin="6">

                                            <!-- Edit Button -->
                                            <Button Content="✏" 
                                                    ToolTip="ပြင်ဆင်ရန်"
                                                    Width="26" 
                                                    Height="26" 
                                                    Margin="0,0,4,0"
                                                    Background="#CC000000" 
                                                    Foreground="White" 
                                                    BorderThickness="0"
                                                    FontSize="11"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.OpenEditBuildingFormCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="13"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>

                                            <!-- Delete Button -->
                                            <Button Content="🗑" 
                                                    ToolTip="ဖျက်ရန်"
                                                    Width="26" 
                                                    Height="26" 
                                                    Background="#CC000000" 
                                                    Foreground="#FF6B6B" 
                                                    BorderThickness="0"
                                                    FontSize="11"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.DeleteBuildingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="13"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Text Section -->
                                    <TextBlock Text="{Binding Name}" 
                                               FontSize="15" 
                                               Margin="4,10,4,4"
                                               FontWeight="SemiBold" 
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimary}"
                                               HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>