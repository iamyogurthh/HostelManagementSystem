<UserControl
    x:Class="HostelManagementSystem.Views.EditBuildingFormView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,16,0" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  1. Header Section  -->
            <StackPanel
                Grid.Row="0"
                Margin="0,0,0,16"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Height="48"
                    Margin="0,0,16,0"
                    Command="{Binding BackCommand}"
                    Content="Back"
                    Style="{StaticResource SecondaryButtonStyle}" />

                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="အဆောင်စီမံခန့်ခွဲမှု" />

                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="14"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="အဆောင်အချက်အလက် ပြင်ဆင်ရန်" />
                </StackPanel>

            </StackPanel>

            <!--  Section Divider  -->
            <Border
                Grid.Row="1"
                Height="1"
                Margin="0,0,0,0"
                Background="gray" />

            <!--  2. Global DB Error Banner  -->
            <TextBlock
                Grid.Row="2"
                Margin="0,0,0,15"
                FontSize="13"
                Foreground="#EF4444"
                Text="{Binding ErrorMessage}"
                TextWrapping="Wrap" />

            <!--  3. Form Content  -->
            <StackPanel Grid.Row="3" Margin="0,0,0,30">

                <!--  Building Name Field  -->
                <Grid Margin="0,0,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="အဆောင်အမည် *" />

                    <TextBox
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource TextBoxStyle}"
                        Text="{Binding BuildingName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="2"
                        Margin="0,6,0,0"
                        FontSize="12"
                        Foreground="#EF4444"
                        Text="{Binding BuildingNameError}" />
                </Grid>

                <!--  Image Selection & Preview Section  -->
                <Grid Margin="0,0,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="အဆောင်ဓာတ်ပုံ" />

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Live 16:9 Image Preview (300x170)  -->
                        <Border
                            Grid.Column="0"
                            Width="300"
                            Height="170"
                            Margin="0,0,20,0"
                            Background="#F8F9FA"
                            BorderBrush="#A0A0A0"
                            BorderThickness="1.5"
                            CornerRadius="8">
                            <Border.Clip>
                                <RectangleGeometry
                                    RadiusX="8"
                                    RadiusY="8"
                                    Rect="0,0,300,170" />
                            </Border.Clip>
                            <Image
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="{Binding PreviewImageSource}"
                                Stretch="UniformToFill" />
                        </Border>

                        <!--  Action Controls (No Editable Path Box)  -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="14"
                                FontWeight="Medium"
                                Foreground="{DynamicResource TextPrimary}"
                                Text="ဓာတ်ပုံရွေးချယ်ပါ" />

                            <TextBlock
                                Margin="0,0,0,16"
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="JPG သို့မဟုတ် PNG ဖိုင်များကိုသာ လက်ခံပါသည်။" />

                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Margin="0,0,10,0"
                                    Command="{Binding BrowseImageCommand}"
                                    Content="Browse Image..."
                                    Style="{StaticResource SecondaryButtonStyle}" />

                                <Button
                                    Command="{Binding ClearSelectedImageCommand}"
                                    Content="Remove"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </StackPanel>

            <!--  4. Form Actions  -->
            <StackPanel
                Grid.Row="4"
                HorizontalAlignment="Left"
                Orientation="Horizontal">
                <Button
                    Margin="0,0,12,0"
                    Command="{Binding SaveCommand}"
                    Content="သိမ်းဆည်းမည်"
                    Style="{StaticResource PrimaryButtonStyle}" />

                <Button
                    Command="{Binding BackCommand}"
                    Content="မလုပ်တော့ပါ"
                    Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>