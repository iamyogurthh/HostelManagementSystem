<UserControl x:Class="HostelManagementSystem.Views.EditBuildingFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="10" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header Section -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="အဆောင်စီမံခန့်ခွဲမှု" 
                           FontSize="24" 
                           FontWeight="Bold"
                           Margin="0 0 0 10"
                           Foreground="{DynamicResource TextPrimary}" />

                <TextBlock Text="အဆောင်အချက်အလက် ပြင်ဆင်ရန်" 
                           FontSize="14" 
                           Foreground="{DynamicResource PrimaryAccent}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Section Divider -->
            <Border Grid.Row="1" Height="1" Background="gray" Margin="0,0,0,0" />

            <!-- 2. Global DB Error Banner -->
            <TextBlock Grid.Row="2" 
                       Text="{Binding ErrorMessage}" 
                       Foreground="#EF4444" 
                       FontSize="13"
                       Margin="0,0,0,15"
                       TextWrapping="Wrap" />

            <!-- 3. Form Content -->
            <StackPanel Grid.Row="3" Margin="0,0,0,30">

                <!-- Building Name Field -->
                <Grid Margin="0,0,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="အဆောင်အမည် *" 
                               Foreground="{DynamicResource TextPrimary}" 
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,8" />

                    <TextBox Grid.Row="1"
                             Text="{Binding BuildingName, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource TextBoxStyle}"
                             HorizontalAlignment="Stretch" />

                    <TextBlock Grid.Row="2"
                               Text="{Binding BuildingNameError}" 
                               Foreground="#EF4444" 
                               FontSize="12" 
                               Margin="0,6,0,0" />
                </Grid>

                <!-- Image Selection & Preview Section -->
                <Grid Margin="0,0,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="အဆောင်ဓာတ်ပုံ" 
                               Foreground="{DynamicResource TextPrimary}" 
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,8" />

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Live 16:9 Image Preview (300x170) -->
                        <Border Grid.Column="0" 
                                Width="300" 
                                Height="170" 
                                CornerRadius="8" 
                                BorderThickness="1.5" 
                                BorderBrush="#A0A0A0" 
                                Background="#F8F9FA"
                                Margin="0,0,20,0">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,300,170" RadiusX="8" RadiusY="8" />
                            </Border.Clip>
                            <Image Source="{Binding PreviewImageSource}" 
                                   Stretch="UniformToFill" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center" />
                        </Border>

                        <!-- Action Controls (No Editable Path Box) -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="ဓာတ်ပုံရွေးချယ်ပါ" 
                                       FontSize="14" 
                                       FontWeight="Medium" 
                                       Foreground="{DynamicResource TextPrimary}" 
                                       Margin="0,0,0,4" />

                            <TextBlock Text="JPG သို့မဟုတ် PNG ဖိုင်များကိုသာ လက်ခံပါသည်။" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextSecondary}" 
                                       Margin="0,0,0,16" />

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Browse Image..." 
                                        Command="{Binding BrowseImageCommand}" 
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,10,0" />

                                <Button Content="Remove" 
                                        Command="{Binding ClearSelectedImageCommand}" 
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </StackPanel>

            <!-- 4. Form Actions -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="သိမ်းဆည်းမည်" 
                        Command="{Binding SaveCommand}" 
                        Style="{StaticResource PrimaryButtonStyle}" 
                        Margin="0,0,12,0" />

                <Button Content="မလုပ်တော့ပါ" 
                        Command="{Binding BackCommand}" 
                        Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>