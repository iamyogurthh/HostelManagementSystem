<UserControl x:Class="HostelManagementSystem.Views.FloorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HostelManagementSystem.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <!-- Header Title -->
            <TextBlock Text="အဆောင်စီမံခန့်ခွဲမှု" 
                       FontSize="24" 
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,20"/>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Content="Back"
                        Grid.Column="0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Command="{Binding BackCommand}" />

                <TextBlock Text="{Binding Building.Name, StringFormat='&quot;{0}&quot; ၏ အထပ်များ'}" 
                           Grid.Column="1"
                           FontSize="18" 
                           FontWeight="SemiBold"
                           Foreground="#671EE1"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

                <Button Content="+ အထပ်အသစ်"
                        Grid.Column="2"
                        Style="{StaticResource PrimaryButtonStyle}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Command="{Binding OpenCreateFloorFormCommand}" />        
            </Grid>
            
            <!-- Main Content-->
            <Grid>
                <!-- 1. Empty State Indicator -->
                <StackPanel Visibility="{Binding HasNoFloors, Converter={StaticResource BoolToVisConverter}, Mode=OneWay}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,60,0,60">
                    <Border Width="80" 
                           Height="80" 
                           CornerRadius="40" 
                           Background="#F3F4F6" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,16">
                        <TextBlock Text="🏢" 
                                  FontSize="36" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="အထပ်များ မရှိသေးပါ" 
                              FontSize="18" 
                              FontWeight="Bold" 
                              Foreground="{DynamicResource TextPrimary}" 
                              HorizontalAlignment="Center" 
                              Margin="0,0,0,6" />

                    <TextBlock Text="အထပ်အသစ် ထည့်သွင်းရန် '+ အထပ်အသစ်' ခလုတ်ကို နှိပ်ပါ။" 
                              FontSize="13" 
                              Foreground="{DynamicResource TextSecondary}" 
                              HorizontalAlignment="Center" 
                              Margin="0,0,0,20" />

                    <Button Content="+ အထပ်အသစ် ထည့်ရန်"
                           Style="{StaticResource PrimaryButtonStyle}"
                           HorizontalAlignment="Center"
                           Command="{Binding OpenCreateFloorFormCommand}" />
                </StackPanel>
                <!-- 2. Floor Grid  -->
                <ItemsControl ItemsSource="{Binding Floors}"
                              Visibility="{Binding HasFloors, Converter={StaticResource BoolToVisConverter}, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Card Container with Natural Height Sizing -->
                            <Border Width="210" 
                                    Padding="8"
                                    Margin="0,0,20,20" 
                                    CornerRadius="10" 
                                    Background="{DynamicResource PrimaryBackgroundBrush}" 
                                    BorderBrush="{DynamicResource BorderBrush}" 
                                    BorderThickness="1"
                                    Cursor="Hand">  

                                <Border.Effect>
                                    <DropShadowEffect Direction="270" BlurRadius="12" ShadowDepth="3" Opacity="0.08" Color="#000000"/>
                                </Border.Effect>

                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" 
                                                  Command="{Binding DataContext.SelectFloorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                  CommandParameter="{Binding}" />
                                </Border.InputBindings>

                                <StackPanel>
                                    <!-- Fixed 16:9 Image Preview Area (Width: 194px, Height: 120px) -->
                                    <Grid Height="120">
                                        <Border CornerRadius="6" ClipToBounds="True">
                                            <Image Source="{Binding Img}" 
                                                   Stretch="UniformToFill"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />    
                                        </Border>

                                        <!-- Floating Action Buttons -->
                                        <StackPanel Orientation="Horizontal" 
                                                    HorizontalAlignment="Right" 
                                                    VerticalAlignment="Top" 
                                                    Margin="6"> 

                                            <!-- Edit Button -->
                                            <Button Content="✏" 
                                                    ToolTip="ပြင်ဆင်ရန်"
                                                    Width="26" 
                                                    Height="26" 
                                                    Margin="0,0,4,0"
                                                    Background="#CC000000" 
                                                    Foreground="White" 
                                                    BorderThickness="0"
                                                    FontSize="11"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.OpenEditFloorFormCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}">   
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="13"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>

                                            <!-- Delete Button -->
                                            <Button Content="🗑" 
                                                    ToolTip="ဖျက်ရန်"
                                                    Width="26" 
                                                    Height="26" 
                                                    Background="#CC000000" 
                                                    Foreground="#FF6B6B" 
                                                    BorderThickness="0"
                                                    FontSize="11"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.DeleteFloorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}">   
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="13"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Text Section -->
                                    <TextBlock Text="{Binding Name}" 
                                               FontSize="15" 
                                               Margin="4,10,4,4"
                                               FontWeight="SemiBold" 
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimary}"
                                               HorizontalAlignment="Left" />    
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
