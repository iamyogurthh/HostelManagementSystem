<UserControl
    x:Class="HostelManagementSystem.Views.ResidentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="750"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <!--  MAIN CONTENT  -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,16,0">

                <!--  HEADER TITLE & ACTION BUTTONS  -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="အဆောင်နေသူများ စီမံခန့်ခွဲမှု" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="14"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="အဆောင်သားများ စာရင်း" />
                    </StackPanel>

                    <!--  Action Buttons  -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!--  Manage Student Categories Button  -->
                        <Button
                            Height="48px"
                            Margin="0,0,8,0"
                            Command="{Binding OpenStudentCategoryManagementCommand}"
                            Content="ကျောင်းသား အမျိုးအစားများ"
                            Style="{StaticResource SecondaryButtonStyle}" />

                        <!--  Add New Student Button  -->
                        <Button
                            Height="48px"
                            Command="{Binding OpenAddNewStudentFormCommand}"
                            Content="+ လူအသစ်ထည့်ရန်"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
                <!--  SEARCH & FILTER PANEL  -->
                <Border Margin="0,0,0,16" CornerRadius="8">
                    <Grid VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Search Input (Using TextBoxStyle)  -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                            <ui:TextBox
                                Height="48"
                                VerticalContentAlignment="Center"
                                ClearButtonEnabled="True"
                                Icon="Search24"
                                PlaceholderText="အမည် (သို့) မှတ်ပုံတင်ဖြင့် ရှာရန်"
                                Text="{Binding SearchName, UpdateSourceTrigger=PropertyChanged}">
                                <ui:TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding ApplyFilterAndReloadCommand}" />
                                </ui:TextBox.InputBindings>
                            </ui:TextBox>
                        </StackPanel>

                        <!--  Cascading Room Selection Dropdowns  -->
                        <StackPanel
                            Grid.Column="1"
                            Margin="16,0"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal">

                            <!--  Building Dropdown  -->
                            <StackPanel Margin="0,0,10,0" VerticalAlignment="Bottom">
                                <TextBlock
                                    Margin="0,0,0,6"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Text="အဆောက်အအုံ" />
                                <ComboBox
                                    Width="150"
                                    Height="38"
                                    Padding="8,0"
                                    VerticalContentAlignment="Center"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding AvailableBuildings}"
                                    SelectedItem="{Binding SelectedBuilding, Mode=TwoWay}" />
                            </StackPanel>

                            <!--  Floor Dropdown  -->
                            <StackPanel Margin="0,0,10,0" VerticalAlignment="Bottom">
                                <TextBlock
                                    Margin="0,0,0,6"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Text="အထပ်" />
                                <ComboBox
                                    Width="130"
                                    Height="38"
                                    Padding="8,0"
                                    VerticalContentAlignment="Center"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding AvailableFloors}"
                                    SelectedItem="{Binding SelectedFloor, Mode=TwoWay}" />
                            </StackPanel>

                            <!--  Room Dropdown  -->
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock
                                    Margin="0,0,0,6"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Text="အခန်း" />
                                <ComboBox
                                    Width="130"
                                    Height="38"
                                    Padding="8,0"
                                    VerticalContentAlignment="Center"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding AvailableRooms}"
                                    SelectedItem="{Binding SelectedRoom, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>

                        <!--  Action Buttons  -->
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal">
                            <Button
                                Height="38"
                                Margin="0,0,8,0"
                                Padding="16,0"
                                VerticalContentAlignment="Center"
                                Command="{Binding ApplyFilterAndReloadCommand}"
                                Content="Search"
                                Style="{StaticResource PrimaryButtonStyle}" />
                            <Button
                                Height="38"
                                Padding="16,0"
                                VerticalContentAlignment="Center"
                                Command="{Binding ResetFiltersCommand}"
                                Content="Clear"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  RESIDENTS DATA TABLE  -->
                <Border
                    Background="White"
                    BorderBrush="{DynamicResource PrimaryAccent}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <DataGrid
                            AutoGenerateColumns="False"
                            Background="Transparent"
                            CanUserAddRows="False"
                            ColumnWidth="*"
                            GridLinesVisibility="Horizontal"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding Students}"
                            RowHeight="54">

                            <DataGrid.Columns>
                                <!--  Column 1: Name  -->
                                <DataGridTextColumn
                                    Width="1.3*"
                                    Binding="{Binding Name}"
                                    Header="အမည်" />

                                <!--  Column 1: Category  -->
                                <DataGridTextColumn
                                    Width="1.3*"
                                    Binding="{Binding StudentCategory.Name}"
                                    Header="Category" />

                                <!--  Column 2: NRC  -->
                                <DataGridTextColumn
                                    Width="1.6*"
                                    Binding="{Binding NRC}"
                                    Header="မှတ်ပုံတင်အမှတ်" />

                                <!--  Column 3: Phone  -->
                                <DataGridTextColumn
                                    Width="1.2*"
                                    Binding="{Binding Student_ph}"
                                    Header="ဖုန်းနံပါတ်" />

                                <!--  Column 4: Father Name  -->
                                <DataGridTextColumn
                                    Width="1.3*"
                                    Binding="{Binding Father_name}"
                                    Header="အဖအမည်" />

                                <!--  Column 5: Building & Room  -->
                                <DataGridTemplateColumn Width="1.2*" Header="Current">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <!--  Building  -->
                                                <TextBlock
                                                    Margin="0,0,0,4"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource PrimaryAccent}"
                                                    LineHeight="11"
                                                    LineStackingStrategy="BlockLineHeight"
                                                    Text="{Binding CurrentAccommodation.Room.Floor.Building.Name, FallbackValue=''}"
                                                    TextTrimming="CharacterEllipsis" />

                                                <!--  Floor  -->
                                                <TextBlock
                                                    Margin="0,0,0,4"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource PrimaryAccent}"
                                                    LineHeight="11"
                                                    LineStackingStrategy="BlockLineHeight"
                                                    Text="{Binding CurrentAccommodation.Room.Floor.Name, FallbackValue='အခန်းမရှိသေးပါ'}"
                                                    TextTrimming="CharacterEllipsis" />

                                                <!--  Room  -->
                                                <TextBlock
                                                    Margin="0,0,0,2"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource PrimaryAccent}"
                                                    LineHeight="11"
                                                    LineStackingStrategy="BlockLineHeight"
                                                    Text="{Binding CurrentAccommodation.Room.Name, FallbackValue=''}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="1.0*" Header="ခုံနံပါတ်">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center" Text="{Binding LatestRollNumber, FallbackValue='-'}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!--  Column 7: Actions  -->
                                <DataGridTemplateColumn Width="180" Header="လုပ်ဆောင်ချက်များ">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">

                                                <!--  Detail Button  -->
                                                <ui:Button
                                                    Width="32"
                                                    Height="32"
                                                    Margin="0,0,8,0"
                                                    Padding="0"
                                                    Command="{Binding DataContext.NavigateToStudentDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Icon="{ui:SymbolIcon Info24}"
                                                    Style="{StaticResource InfoActionButtonStyle}"
                                                    ToolTip="အသေးစိတ်ကြည့်ရန်" />

                                                <!--  Assign Room Button  -->
                                                <ui:Button
                                                    Width="32"
                                                    Height="32"
                                                    Margin="0,0,8,0"
                                                    Padding="0"
                                                    Command="{Binding DataContext.AssignRoomCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}"
                                                    Icon="{ui:SymbolIcon Home24}"
                                                    Style="{StaticResource InfoActionButtonStyle}"
                                                    ToolTip="အခန်းသတ်မှတ်ရန် / ပြောင်းရန်" />


                                                <!--  Edit Button  -->
                                                <ui:Button
                                                    Width="32"
                                                    Height="32"
                                                    Margin="0,0,8,0"
                                                    Padding="0"
                                                    Command="{Binding DataContext.EditStudentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Icon="{ui:SymbolIcon Edit24}"
                                                    Style="{StaticResource EditActionButtonStyle}"
                                                    ToolTip="ပြင်ဆင်ရန်" />

                                                <!--  Delete Button  -->
                                                <ui:Button
                                                    Width="32"
                                                    Height="32"
                                                    Margin="0,0,8,0"
                                                    Padding="0"
                                                    Command="{Binding DataContext.DeleteStudentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}"
                                                    Icon="{ui:SymbolIcon Delete24}"
                                                    Style="{StaticResource DeleteActionButtonStyle}"
                                                    ToolTip="ဖျက်ရန်" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!--  PAGINATION BAR  -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Left: Records Info & Page Size  -->
                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}">
                            <Run Text="စုစုပေါင်း စာရင်း :" />
                            <Run
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextPrimary}"
                                Text="{Binding TotalCount, Mode=OneWay}" />
                            <Run Text=" ဦး" />
                        </TextBlock>

                        <StackPanel
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="တစ်မျက်နှာလျှင် :" />
                            <ComboBox
                                Width="70"
                                ItemsSource="{Binding PageSizeOptions}"
                                SelectedItem="{Binding PageSize}" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Right: Navigation Buttons  -->
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                        <Button
                            Margin="0,0,4,0"
                            Padding="10,6"
                            Command="{Binding FirstPageCommand}"
                            Content="«"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="ပထမဆုံး မျက်နှာဖုံး" />
                        <Button
                            Margin="0,0,4,0"
                            Padding="10,6"
                            Command="{Binding PreviousPageCommand}"
                            Content="‹"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="ရှေ့သို့" />

                        <TextBlock
                            Margin="10,0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}">
                            <Run Text="{Binding CurrentPage, Mode=OneWay}" />
                            <Run Text=" / " />
                            <Run Text="{Binding TotalPages, Mode=OneWay}" />
                        </TextBlock>

                        <Button
                            Margin="4,0,0,0"
                            Padding="10,6"
                            Command="{Binding NextPageCommand}"
                            Content="›"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="နောက်သို့" />
                        <Button
                            Margin="4,0,0,0"
                            Padding="10,6"
                            Command="{Binding LastPageCommand}"
                            Content="»"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="နောက်ဆုံး မျက်နှာဖုံး" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!--  LOADING INDICATOR OVERLAY  -->
        <Border Background="#66FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border
                Padding="24,18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                BorderBrush="{DynamicResource PrimaryAccent}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel HorizontalAlignment="Center">
                    <ProgressBar
                        Width="180"
                        Height="6"
                        Margin="0,0,0,12"
                        Foreground="{DynamicResource PrimaryAccent}"
                        IsIndeterminate="True" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="14"
                        FontWeight="Medium"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="အချက်အလက်များ ရယူနေပါသည်..." />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>