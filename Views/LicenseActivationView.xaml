<UserControl
    x:Class="HostelManagementSystem.Views.LicenseActivationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!--  Close Button  -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">

            <Setter Property="Width" Value="36" />

            <Setter Property="Height" Value="36" />

            <Setter Property="Padding" Value="0" />

            <Setter Property="Background" Value="Transparent" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="CloseBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">

                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="22"
                                FontWeight="Light"
                                Foreground="{TemplateBinding Foreground}"
                                Text="×" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="CloseBorder" Property="Background" Value="{DynamicResource SidebarHoverTint}" />

                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="CloseBorder" Property="Background" Value="{DynamicResource BorderColor}" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>


    <!--  Transparent background  -->
    <Grid Background="Transparent" MouseLeftButtonDown="Window_MouseLeftButtonDown">

        <!--  Activation Form  -->
        <Border
            Width="520"
            Padding="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1"
            CornerRadius="12">

            <Border.Effect>

                <DropShadowEffect
                    BlurRadius="25"
                    Opacity="0.18"
                    ShadowDepth="4" />

            </Border.Effect>


            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />

                </Grid.RowDefinitions>


                <!--  Close Button  -->

                <Button
                    Grid.Row="0"
                    Width="36"
                    Height="36"
                    Margin="0,-28,-28,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource CloseButtonStyle}"
                    ToolTip="Close" />


                <!--  Logo  -->

                <Border
                    Grid.Row="0"
                    Width="64"
                    Height="64"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    CornerRadius="16">

                    <Image
                        Width="40"
                        Height="40"
                        Margin="0,0,5,0"
                        Source="pack://application:,,,/Image/hms_logo.png" />

                </Border>


                <!--  Application Name  -->

                <TextBlock
                    Grid.Row="1"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="Hostel Management System" />


                <!--  Page Title  -->

                <TextBlock
                    Grid.Row="2"
                    Margin="0,6,0,30"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="License Activation" />


                <!--  License Key  -->

                <StackPanel Grid.Row="3">

                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="License Key" />

                    <TextBox
                        Height="48"
                        Style="{StaticResource TextBoxStyle}"
                        Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Margin="2,7,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="Enter the license key provided for your HMS application." />

                </StackPanel>


                <!--  Machine ID  -->

                <StackPanel Grid.Row="4" Margin="0,22,0,0">

                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="Machine ID" />

                    <Grid>

                        <TextBox
                            Height="48"
                            Padding="12,10"
                            Background="{DynamicResource WindowBackground}"
                            BorderBrush="{DynamicResource BorderColor}"
                            Foreground="{DynamicResource TextSecondary}"
                            IsReadOnly="True"
                            Text="{Binding MachineId}" />

                        <Button
                            Width="Auto"
                            Height="Auto"
                            Margin="0,0,7,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Command="{Binding CopyMachineIdCommand}"
                            Content="Copy"
                            Style="{StaticResource SecondaryButtonStyle}" />

                    </Grid>

                    <TextBlock
                        Margin="2,7,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="Automatically generated from this computer." />

                </StackPanel>


                <!--  License Information  -->

                <Border
                    Grid.Row="5"
                    Margin="0,22,0,0"
                    Padding="14"
                    Background="{DynamicResource WindowBackground}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="7">

                    <StackPanel>

                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="License Status" />

                        <TextBlock
                            Margin="0,5,0,0"
                            FontSize="13"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="{Binding StatusMessage}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="{Binding LicenseInformation}"
                            TextWrapping="Wrap" />

                    </StackPanel>

                </Border>


                <!--  Activation Button  -->

                <Button
                    Grid.Row="6"
                    Height="46"
                    Margin="0,22,0,0"
                    Command="{Binding ActivateCommand}"
                    Content="Activate License"
                    IsEnabled="{Binding IsNotBusy}"
                    Style="{StaticResource PrimaryButtonStyle}" />


                <!--  Loading  -->

                <StackPanel
                    Grid.Row="7"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <ProgressBar
                        Width="80"
                        Height="3"
                        Foreground="{DynamicResource PrimaryAccent}"
                        IsIndeterminate="True" />

                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="Activating..." />

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</UserControl>