<UserControl
    x:Class="HostelManagementSystem.Views.SettingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settingViews="clr-namespace:HostelManagementSystem.Views.SettingViews"
    xmlns:settingVm="clr-namespace:HostelManagementSystem.ViewModels.SettingViewModels"
    d:DesignHeight="600"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <UserControl.Resources>

        <!--  Theme View  -->
        <DataTemplate DataType="{x:Type settingVm:ThemeSettingsViewModel}">
            <settingViews:ThemeSettingsView />
        </DataTemplate>

        <!--  License View  -->
        <DataTemplate DataType="{x:Type settingVm:LicenseSettingsViewModel}">
            <settingViews:LicenseSettingsView />
        </DataTemplate>

    </UserControl.Resources>

    <Grid Margin="0,0,16,0">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Page Header  -->
        <TextBlock
            Grid.Row="0"
            FontSize="24"
            FontWeight="Bold"
            Foreground="{DynamicResource TextPrimary}"
            Text="Settings" />

        <!--  Settings Area  -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <!--  Settings Sidebar  -->
                <ColumnDefinition Width="190" />

                <!--  Gap  -->
                <ColumnDefinition Width="8" />

                <!--  Settings Content  -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Settings Sidebar  -->
            <Border
                Grid.Column="0"
                Padding="0,8,0,8"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="8">

                <StackPanel>

                    <RadioButton
                        Command="{Binding SelectThemeCommand}"
                        GroupName="SettingsNavigation"
                        IsChecked="True"
                        Style="{StaticResource SidebarItemStyle}"
                        Tag="M12,3A9,9 0,1 0,21,12A9,9 0,0 0,12,3M12,19A7,7 0,1 1,19,12A7,7 0,0 1,12,19M12,7A5,5 0,0 0,12,17A5,5 0,0 0,12,7Z">

                        <TextBlock VerticalAlignment="Center" Text="Theme" />

                    </RadioButton>

                    <RadioButton
                        Command="{Binding SelectLicenseCommand}"
                        GroupName="SettingsNavigation"
                        Style="{StaticResource SidebarItemStyle}"
                        Tag="M4,5A2,2 0,0 1,6,3H18A2,2 0,0 1,20,5V19A2,2 0,0 1,18,21H6A2,2 0,0 1,4,19V5M7,7V9H17V7H7M7,12V14H17V12H7M7,17V19H12V17H7Z">

                        <TextBlock VerticalAlignment="Center" Text="License" />

                    </RadioButton>

                    <RadioButton
                        Command="{Binding SelectLicenseCommand}"
                        GroupName="SettingsNavigation"
                        Style="{StaticResource SidebarItemStyle}"
                        Tag="M6,2H14L19,7V22H6V2M14,2V8H19M9,12H16M9,16H16M9,20H13">

                        <TextBlock VerticalAlignment="Center" Text="Versions" />

                    </RadioButton>
                    <RadioButton
                        Command="{Binding SelectLicenseCommand}"
                        GroupName="SettingsNavigation"
                        Style="{StaticResource SidebarItemStyle}"
                        Tag="M12,2A10,10 0,1 0,12,22A10,10 0,0 0,12,2M11,10H13V17H11V10M11,6H13V8H11V6Z">

                        <TextBlock VerticalAlignment="Center" Text="About" />

                    </RadioButton>


                </StackPanel>

            </Border>

            <!--  Selected Settings Content  -->
            <Border
                Grid.Column="2"
                Padding="20"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="8">

                <ContentControl Content="{Binding CurrentSettingViewModel}" />

            </Border>

        </Grid>

    </Grid>

</UserControl>