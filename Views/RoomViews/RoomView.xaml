<UserControl
    x:Class="HostelManagementSystem.Views.RoomView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HostelManagementSystem.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>


    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,16,0">
            <!--  Header Title  -->
            <TextBlock
                Margin="0,0,0,16"
                FontSize="24"
                FontWeight="Bold"
                Foreground="{DynamicResource TextPrimary}"
                Text="အဆောင်စီမံခန့်ခွဲမှု" />

            <!--  Action & Navigation Bar  -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding BackCommand}"
                    Content="Back"
                    Style="{StaticResource SecondaryButtonStyle}" />

                <!--  Context Header: Building Name & Floor Name  -->
                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#671EE1"
                        Text="{Binding Building.Name, StringFormat='&quot;{0}&quot; - '}" />
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#671EE1"
                        Text="{Binding Floor.Name, StringFormat='&quot;{0}&quot; ၏ အခန်းများ'}" />
                </StackPanel>

                <Button
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding OpenCreateRoomFormCommand}"
                    Content="+ အခန်းအသစ်"
                    Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>

            <!--  Main Content  -->
            <Grid>
                <!--  1. Empty State Indicator  -->
                <StackPanel
                    Margin="0,60,0,60"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasNoRooms, Converter={StaticResource BoolToVisConverter}, Mode=OneWay}">
                    <Border
                        Width="80"
                        Height="80"
                        Margin="0,0,0,16"
                        HorizontalAlignment="Center"
                        Background="#F3F4F6"
                        CornerRadius="40">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="36"
                            Text="🚪" />
                    </Border>

                    <TextBlock
                        Margin="0,0,0,6"
                        HorizontalAlignment="Center"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="အခန်းများ မရှိသေးပါ" />

                    <TextBlock
                        Margin="0,0,0,20"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="အခန်းအသစ် ထည့်သွင်းရန် '+ အခန်းအသစ်' ခလုတ်ကို နှိပ်ပါ။" />

                    <Button
                        HorizontalAlignment="Center"
                        Command="{Binding OpenCreateRoomFormCommand}"
                        Content="+ အခန်းအသစ် ထည့်ရန်"
                        Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>

                <!--  2. Room Grid  -->
                <ItemsControl ItemsSource="{Binding Rooms}" Visibility="{Binding HasRooms, Converter={StaticResource BoolToVisConverter}, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!--  Card Container with Natural Height Sizing  -->
                            <Border Width="210" Style="{StaticResource InteractiveCardStyle}">

                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="12"
                                        Direction="270"
                                        Opacity="0.08"
                                        ShadowDepth="3"
                                        Color="#000000" />
                                </Border.Effect>

                                <Border.InputBindings>
                                    <MouseBinding
                                        Command="{Binding DataContext.SelectRoomCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        MouseAction="LeftClick" />
                                </Border.InputBindings>

                                <StackPanel>
                                    <!--  Fixed 16:9 Image Preview Area (Width: 194px, Height: 120px)  -->
                                    <Grid Height="120">
                                        <Border ClipToBounds="True" CornerRadius="6">
                                            <Image
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Stretch="UniformToFill">
                                                <Image.Source>
                                                    <BitmapImage
                                                        CacheOption="OnLoad"
                                                        DecodePixelWidth="300"
                                                        UriSource="{Binding Img, TargetNullValue='pack://application:,,,/Image/DefaultImages/default_room.png'}" />
                                                </Image.Source>
                                            </Image>
                                        </Border>

                                        <!--  Floating Action Buttons  -->
                                        <StackPanel
                                            Margin="6"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Orientation="Horizontal">

                                            <!--  Edit Button  -->
                                            <Button
                                                Height="26"
                                                Margin="0,0,4,0"
                                                Background="#CC000000"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.OpenEditRoomFormCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="✏"
                                                Cursor="Hand"
                                                FontSize="11"
                                                Foreground="White"
                                                ToolTip="ပြင်ဆင်ရန်">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="13" />
                                                    </Style>
                                                </Button.Resources>
                                            </Button>

                                            <!--  Delete Button  -->
                                            <Button
                                                Height="26"
                                                Background="#CC000000"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.DeleteRoomCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="🗑"
                                                Cursor="Hand"
                                                FontSize="11"
                                                Foreground="#FF6B6B"
                                                ToolTip="ဖျက်ရန်">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="13" />
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!--  Text Section  -->
                                    <StackPanel Margin="4,10,4,4">
                                        <!--  Room Name  -->
                                        <TextBlock
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextPrimary}"
                                            Text="{Binding Name}" />

                                        <!--  Icon + Ratio (e.g. 👤 0/4)  -->
                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextPrimary}"
                                                Text="👤 " />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="SemiBold">
                                                <Run Foreground="{DynamicResource TextPrimary}" Text="{Binding CurrentResidentsCount, Mode=OneWay, FallbackValue=0}" />
                                                <Run Foreground="{DynamicResource TextSecondary}" Text="/" />
                                                <Run Foreground="{DynamicResource TextPrimary}" Text="{Binding Capacity, Mode=OneWay, FallbackValue=0}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>