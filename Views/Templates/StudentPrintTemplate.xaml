<UserControl
    x:Class="HostelManagementSystem.Views.Templates.StudentPrintTemplate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="794"
    Height="1123"
    Background="White"
    FontFamily="Pyidaungsu, Segoe UI"
    Foreground="Black">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  Header  -->
            <RowDefinition Height="Auto" />
            <!--  Student Overview  -->
            <RowDefinition Height="*" />
            <!--  Academic & Personal Details  -->
            <RowDefinition Height="Auto" />
            <!--  Footer  -->
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,20"
            Padding="0,0,0,15"
            BorderBrush="#333"
            BorderThickness="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontSize="20"
                        FontWeight="Bold"
                        Text="သူ့ထက်သာ အဆောင်" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="14"
                        Foreground="#555"
                        Text="ကျောင်းသား အချက်အလက် မှတ်တမ်း" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    FontSize="12"
                    Text="{Binding PrintDate, StringFormat='ရက်စွဲ: {0:yyyy-MM-dd}'}" />
            </Grid>
        </Border>

        <!--  Profile Section  -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Student Photo  -->
            <Border
                Grid.Column="0"
                Width="110"
                Height="130"
                BorderBrush="#CCC"
                BorderThickness="1"
                CornerRadius="4">
                <Image Source="{Binding ProfileImagePath}" Stretch="UniformToFill" />
            </Border>

            <!--  Key Info Table  -->
            <Grid Grid.Column="1" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    FontWeight="SemiBold"
                    Text="အမည်:" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="{Binding Student.Name}" />

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    FontWeight="SemiBold"
                    Text="ကျား/မ:" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="3"
                    Text="{Binding Student.Gender}" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    FontWeight="SemiBold"
                    Text="မှတ်ပုံတင်အမှတ်:" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="{Binding Student.NRC}" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="2"
                    FontWeight="SemiBold"
                    Text="မွေးသက္ကရာဇ်:" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="3"
                    Text="{Binding Student.Birthday, StringFormat='{}{0:yyyy-MM-dd}'}" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    FontWeight="SemiBold"
                    Text="အဓိကဘာသာ:" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Text="{Binding Student.Major}" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="2"
                    FontWeight="SemiBold"
                    Text="ဖုန်းနံပါတ်:" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="3"
                    Text="{Binding Student.Student_ph}" />

                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    FontWeight="SemiBold"
                    Text="အဆောင် / အခန်း:" />
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="1"
                    Grid.ColumnSpan="3">
                    <Run Text="{Binding Building.Name}" />
                    -<Run Text="{Binding Floor.Name}" />
                    -<Run Text="{Binding Room.Name}" />
                </TextBlock>
            </Grid>
        </Grid>

        <!--  Detailed Form Information  -->
        <StackPanel Grid.Row="2">
            <!--  Parent Info Section  -->
            <TextBlock
                Margin="0,0,0,8"
                FontSize="14"
                FontWeight="Bold"
                Text="မိဘ အချက်အလက်များ" />
            <Border
                Margin="0,0,0,10"
                BorderBrush="#DDD"
                BorderThickness="0,0,0,1" />
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="26" />
                    <RowDefinition Height="26" />
                    <RowDefinition Height="26" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    FontWeight="SemiBold"
                    Text="ဖခင်အမည်:" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="{Binding Student.Father_name}" />

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    FontWeight="SemiBold"
                    Text="ဖခင် NRC:" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="3"
                    Text="{Binding Student.Father_NRC}" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    FontWeight="SemiBold"
                    Text="မိခင်အမည်:" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="{Binding Student.Mother_name}" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="2"
                    FontWeight="SemiBold"
                    Text="မိခင် NRC:" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="3"
                    Text="{Binding Student.Mother_NRC}" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    FontWeight="SemiBold"
                    Text="မိဘ ဖုန်းနံပါတ်:" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Text="{Binding Student.Parent_ph}" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="2"
                    FontWeight="SemiBold"
                    Text="နေရပ်လိပ်စာ:" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="3"
                    Text="{Binding Student.Address}" />
            </Grid>

            <!--  Academic Records Section  -->
            <TextBlock
                Margin="0,10,0,8"
                FontSize="14"
                FontWeight="Bold"
                Text="ပညာအရည်အချင်း မှတ်တမ်းများ" />
            <Border
                Margin="0,0,0,10"
                BorderBrush="#DDD"
                BorderThickness="0,0,0,1" />
            <DataGrid
                AutoGenerateColumns="False"
                Background="Transparent"
                BorderBrush="#CCC"
                BorderThickness="1"
                CanUserAddRows="False"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                ItemsSource="{Binding AcademicRecords}"
                RowHeight="26">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding AcademicYearLevel}"
                        Header="သင်တန်းနှစ်" />
                    <DataGridTextColumn
                        Width="110"
                        Binding="{Binding RollNumber}"
                        Header="ခုံအမှတ်" />
                    <DataGridTextColumn
                        Width="160"
                        Binding="{Binding AttendedYear}"
                        Header="တက်ရောက်သည့်နှစ်" />
                    <DataGridTextColumn
                        Width="70"
                        Binding="{Binding AttemptNumber}"
                        Header="ကြိမ်ရေ" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <!--  Footer / Signatures  -->
        <Grid Grid.Row="3" Margin="0,30,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Width="200" HorizontalAlignment="Left">
                <Border
                    Margin="0,40,0,5"
                    BorderBrush="#666"
                    BorderThickness="0,1,0,0" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Text="ကျောင်းသား လက်မှတ်" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Width="200"
                HorizontalAlignment="Right">
                <Border
                    Margin="0,40,0,5"
                    BorderBrush="#666"
                    BorderThickness="0,1,0,0" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Text="အဆောင်မှူး လက်မှတ်" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>