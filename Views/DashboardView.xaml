<UserControl
    x:Class="HostelManagementSystem.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:HostelManagementSystem.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
    d:DesignHeight="800"
    d:DesignWidth="1100"
    FontFamily="Segoe UI"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/DashboardStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ================= HEADER & ACTIONS =================  -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="Dashboard" />
                    <TextBlock
                        FontSize="14"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="Welcome back! Here is your hostel summary." />
                </StackPanel>

                <!--  Quick Action Buttons  -->
                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Height="42"
                        Margin="0,0,8,0"
                        Command="{Binding OpenStudentCategoryManagementCommand}"
                        Content="ကျောင်းသား အမျိုးအစားများ"
                        Style="{StaticResource PrimaryButtonStyle}" />
                    <Button
                        Height="42"
                        Margin="0,0,0,0"
                        Command="{Binding OpenRoomTypeManagementCommand}"
                        Content="အခန်းအမျိုးအစားများ"
                        Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>

            <!--  ================= 1. KPI COUNTERS =================  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Total Students  -->
                <Border
                    Grid.Column="0"
                    Margin="0,0,8,8"
                    Padding="16"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Foreground="{DynamicResource TextSecondary}" Text="ကျောင်းသား အရေအတွက်" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextPrimary}"
                                Text="{Binding TotalStudents}" />
                            <TextBlock
                                Margin="0,6,0,0"
                                FontSize="11"
                                FontWeight="bold"
                                Foreground="#2D8C6C"
                                Text="လက်ရှိနေထိုင်သူ" />
                        </StackPanel>
                        <ui:SymbolIcon
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            FontSize="24"
                            Foreground="{DynamicResource TextSecondary}"
                            Symbol="People24" />
                    </Grid>
                </Border>

                <!--  Occupancy Rate Card  -->
                <Border
                    Grid.Column="1"
                    Margin="0,0,8,8"
                    Padding="16"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Foreground="{DynamicResource TextSecondary}" Text="နေထိုင်မှုနှုန်း" />
                            <DockPanel Margin="0,4,0,0">
                                <TextBlock
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Text="{Binding OccupancyRate, StringFormat='{}{0:0.0}%'}" />
                                <TextBlock
                                    Margin="6,0,0,4"
                                    VerticalAlignment="Bottom"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{Binding TotalCapacity, StringFormat='({0} total capacity)'}" />
                            </DockPanel>
                            <ProgressBar
                                Height="6"
                                Margin="0,12,0,0"
                                Background="{DynamicResource ProgressBarBackground}"
                                Foreground="{DynamicResource ProgressBarForeground}"
                                Maximum="100"
                                Value="{Binding OccupancyRate}" />
                        </StackPanel>
                        <ui:SymbolIcon
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            FontSize="24"
                            Foreground="{DynamicResource TextSecondary}"
                            Symbol="DataPie24" />
                    </Grid>
                </Border>

                <!--  Available Rooms  -->
                <Border
                    Grid.Column="2"
                    Margin="0,0,8,8"
                    Padding="16"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Foreground="{DynamicResource TextSecondary}" Text="ရနိုင်သောအခန်းများ" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="#2D8C6C"
                                Text="{Binding AvailableRooms}" />
                            <TextBlock
                                Margin="0,6,0,0"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="Ready for Allocation" />
                        </StackPanel>
                        <ui:SymbolIcon
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            FontSize="24"
                            Foreground="{DynamicResource TextSecondary}"
                            Symbol="Bed24" />
                    </Grid>
                </Border>

                <!--  Total Rooms  -->
                <Border
                    Grid.Column="3"
                    Margin="0,0,0,8"
                    Padding="16"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Foreground="{DynamicResource TextSecondary}" Text="အခန်းစုစုပေါင်း" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextPrimary}"
                                Text="{Binding TotalRooms}" />
                            <TextBlock
                                Margin="0,6,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="Across All Buildings" />
                        </StackPanel>
                        <ui:SymbolIcon
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            FontSize="24"
                            Foreground="{DynamicResource TextSecondary}"
                            Symbol="Home24" />
                    </Grid>
                </Border>
            </Grid>

            <!--  ================= 2. SPATIAL & DEMOGRAPHIC BREAKDOWNS =================  -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Occupancy by Building  -->
                <Border
                    Grid.Column="0"
                    Margin="0,0,8,8"
                    Padding="16"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="အဆောက်အဦး နေထိုင်မှု အခြေအနေ" />

                        <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding BuildingOccupancies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextPrimary}"
                                                Text="{Binding BuildingName}" />

                                            <DockPanel HorizontalAlignment="Right" DockPanel.Dock="Right">
                                                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}">
                                                    <Run Text="{Binding OccupiedBeds, Mode=OneWay}" />
                                                    <Run Text=" / " />
                                                    <Run Text="{Binding TotalCapacity, Mode=OneWay}" />
                                                    <Run Text=" Beds (" />
                                                    <Run Text="{Binding OccupancyPercentage, Mode=OneWay, StringFormat='{}{0:0.0}'}" />
                                                    <Run Text="%)" />
                                                </TextBlock>
                                            </DockPanel>
                                        </DockPanel>

                                        <ProgressBar
                                            Grid.Row="1"
                                            Height="8"
                                            Foreground="{Binding ProgressBarColor}"
                                            Maximum="100"
                                            Value="{Binding OccupancyPercentage, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!--  Gender Distribution  -->
                <Border
                    Grid.Column="1"
                    Margin="0,0,0,8"
                    Padding="16"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="ကျား၊မ ဦးရေ " />

                        <UniformGrid
                            Margin="0,20,0,8"
                            HorizontalAlignment="Stretch"
                            Columns="2">

                            <!--  Male Circle Card  -->
                            <StackPanel HorizontalAlignment="Center">
                                <Grid Width="110" Height="110">
                                    <ui:ProgressRing
                                        Width="110"
                                        Height="110"
                                        Foreground="{DynamicResource BorderBrush}"
                                        IsIndeterminate="False"
                                        Progress="100" />
                                    <ui:ProgressRing
                                        Width="110"
                                        Height="110"
                                        Foreground="#357ae8"
                                        IsIndeterminate="False"
                                        Progress="{Binding GenderData.MalePercentage, Mode=OneWay}" />

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Foreground="#357ae8"
                                            Text="ကျား" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="20"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource TextPrimary}"
                                            Text="{Binding GenderData.MaleCount, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{Binding GenderData.MalePercentage, Mode=OneWay, StringFormat='{}{0:0.0}%'}" />
                            </StackPanel>

                            <!--  Female Circle Card  -->
                            <StackPanel HorizontalAlignment="Center">
                                <Grid Width="110" Height="110">
                                    <ui:ProgressRing
                                        Width="110"
                                        Height="110"
                                        Foreground="{DynamicResource BorderBrush}"
                                        IsIndeterminate="False"
                                        Progress="100" />
                                    <ui:ProgressRing
                                        Width="110"
                                        Height="110"
                                        Foreground="#EC4899"
                                        IsIndeterminate="False"
                                        Progress="{Binding GenderData.FemalePercentage, Mode=OneWay}" />

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Foreground="#EC4899"
                                            Text="မ" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="20"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource TextPrimary}"
                                            Text="{Binding GenderData.FemaleCount, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{Binding GenderData.FemalePercentage, Mode=OneWay, StringFormat='{}{0:0.0}%'}" />
                            </StackPanel>

                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!--  ================= 3. DEMOGRAPHICS =================  -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Major Distribution  -->
                <Border
                    Grid.Column="0"
                    Margin="0,0,8,8"
                    Padding="16"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="Major Distribution" />

                        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding TopMajors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid HorizontalAlignment="Stretch" Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="4"
                                        Padding="10,8"
                                        Background="{DynamicResource BorderBrush}"
                                        CornerRadius="6">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock
                                                Margin="8,0,0,0"
                                                DockPanel.Dock="Right"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource TextPrimary}"
                                                Text="{Binding StudentCount}" />
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{DynamicResource TextPrimary}"
                                                Text="{Binding MajorName}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding MajorName}" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!--  Academic Year Level Distribution  -->
                <Border
                    Grid.Column="1"
                    Margin="0,0,0,8"
                    Padding="16"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="Academic Year Level" />

                        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding YearLevelDistributions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid HorizontalAlignment="Stretch" Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="4"
                                        Padding="10,8"
                                        Background="{DynamicResource BorderBrush}"
                                        CornerRadius="6">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock
                                                Margin="8,0,0,0"
                                                DockPanel.Dock="Right"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource TextPrimary}"
                                                Text="{Binding StudentCount}" />
                                            <TextBlock
                                                FontSize="13"
                                                Foreground="{DynamicResource TextPrimary}"
                                                Text="{Binding YearLevelName}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding YearLevelName}" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>